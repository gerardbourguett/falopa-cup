---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import MatchCard from "../../components/MatchCard.astro";
import Palmares from "../../components/Palmares.astro";
import HolderChain from "../../components/HolderChain.astro";
import { SITE_TITLE } from "../../consts";
import { getHolderChain } from "../../lib/tournament";

const cupEntries = await getCollection("copa-pablo-milad");
const clubsEntries = await getCollection("clubs");

const clubById = new Map(clubsEntries.map((e) => [e.data.id || e.id, e.data]));

// Get all seasons sorted by year (newest first)
const seasons = cupEntries
  .map((e) => ({
    year: e.data.year,
    matches: e.data.matches.map((m: any) => ({
      ...m,
      date: m.date instanceof Date ? m.date : new Date(m.date),
    })),
  }))
  .sort((a, b) => b.year - a.year);

const currentSeason = seasons[0];

// All matches for palmarés
const allMatches = seasons.flatMap((s) => s.matches);

function countTitleChanges(matches: any[]) {
  return matches.filter(
    (m) => m.status !== "pending" && m.type === "match" && m.newHolderId && m.newHolderId !== m.holderId,
  ).length;
}

function countHolders(matches: any[]) {
  return new Set(matches.filter((m) => m.status !== "pending" && m.newHolderId).map((m) => m.newHolderId))
    .size;
}

function countDefenses(matches: any[]) {
  return matches.filter(
    (m) => m.status !== "pending" && m.type === "match" && m.newHolderId === m.holderId,
  ).length;
}

function seasonMatchCount(matches: any[]) {
  return matches.filter((m) => m.status !== "pending").length;
}

function getChampionId(matches: any[]): string | undefined {
  for (let i = matches.length - 1; i >= 0; i--) {
    if (matches[i].status === "pending") continue;
    if (matches[i].newHolderId) return matches[i].newHolderId;
    if (matches[i].holderId) return matches[i].holderId;
  }
  return undefined;
}

const currentHolder = currentSeason
  ? getChampionId(currentSeason.matches)
  : undefined;
const currentHolderClub = currentHolder ? clubById.get(currentHolder) : undefined;
---

<Layout
  title={`Copa REDACTED — ${SITE_TITLE}`}
  description="Historial de la Copa REDACTED, el titulo del mas malo bajo la regla de la tina."
  currentPath="/copa-pablo-milad"
  image="/og/copa-pablo-milad.svg"
>
  <div class="milad-page">
      <section class="page-hero milad-hero" aria-labelledby="milad-title">
        <div class="hero-pattern" aria-hidden="true"></div>
        <div class="page-hero-inner">
          <div class="hero-copy">
            <p class="page-hero-label">Archivo del anti-campeonato chileno</p>
            <h1 class="page-hero-title" id="milad-title">Copa REDACTED</h1>
            <p class="page-hero-desc">
              Una copa que nadie quiere. El titulo solo cambia cuando quien lo
              defiende <strong>gana</strong>; con empate o derrota, sigue en sus manos.
            </p>
          </div>
          <aside class="holder-note" aria-label="Poseedor actual de la Copa REDACTED">
            <span class="holder-note-label">Poseedor actual</span>
            <span class="holder-note-name">
              {currentHolderClub?.name || currentHolder || "Por definir"}
            </span>
            {currentHolderClub?.logo && (
              <img
                src={currentHolderClub.logo}
                alt=""
                width="44"
                height="44"
                class="holder-note-logo"
              />
            )}
          </aside>
        </div>
      </section>

      <main class="container">
        <section class="palmares-section" aria-label="Palmarés histórico">
          <p class="section-kicker">Registro acumulado</p>
          <Palmares
            allMatches={allMatches}
            clubs={clubById}
            accentColor="burgundy"
            currentHolderId={currentHolder}
          />
        </section>

        <nav class="season-nav" id="season-nav-milad" aria-label="Temporadas Copa REDACTED">
          {
            seasons.map((season) => (
              <a
                href={`#season-${season.year}`}
                class:list={[
                  "season-tab",
                  { active: season.year === currentSeason?.year },
                ]}
                data-year={season.year}
                aria-current={season.year === currentSeason?.year ? "true" : undefined}
              >
                <span class="tab-year">{season.year}</span>
                <span class="tab-count">{seasonMatchCount(season.matches)} P</span>
              </a>
            ))
          }
        </nav>

        {
          seasons.map((season) => (
            <section
              id={`season-${season.year}`}
              class:list={[
                "season-section",
                { hidden: season.year !== currentSeason?.year },
              ]}
              data-season-milad={season.year}
            >
              <header class="season-header">
                <div>
                  <p class="section-kicker">Bitácora de la copa</p>
                  <h2 class="season-title">
                    <span class="season-year">Temporada {season.year}</span>
                  </h2>
                </div>
                <div class="season-stats">
                  <div class="mini-stat">
                    <span class="mini-stat-num">{seasonMatchCount(season.matches)}</span>
                    <span class="mini-stat-label">Partidos</span>
                  </div>
                  <div class="mini-stat">
                    <span class="mini-stat-num">
                      {countTitleChanges(season.matches)}
                    </span>
                    <span class="mini-stat-label">Cambios</span>
                  </div>
                  <div class="mini-stat">
                    <span class="mini-stat-num">
                      {countDefenses(season.matches)}
                    </span>
                    <span class="mini-stat-label">Defensas</span>
                  </div>
                  <div class="mini-stat">
                    <span class="mini-stat-num">
                      {countHolders(season.matches)}
                    </span>
                    <span class="mini-stat-label">Poseedores</span>
                  </div>
                </div>
              </header>

              {/* Holder Chain for this season */}
              {(() => {
                const chain = getHolderChain(season.matches);
                return chain.length > 0 ? (
                  <div class="season-chain">
                    <HolderChain
                      chain={chain}
                      clubs={clubById}
                      accentColor="burgundy"
                      caption={`Cadena de poseedores · Copa REDACTED ${season.year}`}
                    />
                  </div>
                ) : null;
              })()}

              <div class="matches-list">
                {season.matches.map((match: any, index: number) => (
                  <MatchCard
                    match={match}
                    clubs={clubById}
                    index={index}
                    accentColor="burgundy"
                  />
                ))}
              </div>
            </section>
          ))
        }
      </main>
  </div>

    <script>
      function initMiladTabs() {
        const nav = document.getElementById("season-nav-milad");
        if (!nav) return;

        const tabs = nav.querySelectorAll<HTMLAnchorElement>(".season-tab");
        const sections = document.querySelectorAll<HTMLElement>(
          "[data-season-milad]",
        );

        function seasonIdToYear(hashValue: string) {
          return hashValue.replace("#", "").replace("season-", "");
        }

        function showSeason(year: string) {
          tabs.forEach((t) => {
            const isTarget = t.dataset.year === year;
            t.classList.toggle("active", isTarget);
            if (isTarget) {
              t.setAttribute("aria-current", "page");
            } else {
              t.removeAttribute("aria-current");
            }
          });
          sections.forEach((s) => {
            const isTarget = s.dataset.seasonMilad === year;
            s.classList.toggle("hidden", !isTarget);
          });
          history.replaceState(null, "", `#season-${year}`);
        }

        tabs.forEach((tab) => {
          tab.addEventListener("click", (event) => {
            event.preventDefault();
            if (tab.dataset.year) showSeason(tab.dataset.year);
          });
        });

        const hash = seasonIdToYear(window.location.hash);
        if (hash && document.querySelector(`[data-season-milad="${hash}"]`)) {
          showSeason(hash);
        }

        window.addEventListener("hashchange", () => {
          const nextHash = seasonIdToYear(window.location.hash);
          if (nextHash && document.querySelector(`[data-season-milad="${nextHash}"]`)) {
            showSeason(nextHash);
          }
        });
      }

      initMiladTabs();
      document.addEventListener("astro:after-swap", initMiladTabs);
    </script>

    <noscript>
      <style>
        .season-section.hidden {
          display: block !important;
        }
      </style>
    </noscript>

    <style>
      .milad-page {
        --color-bg-primary: #f7f3ec;
        --color-bg-secondary: #fffdf8;
        --color-bg-tertiary: #f0e7e8;
        --color-bg-elevated: #cdbfc0;
        --color-text-primary: #21191b;
        --color-text-secondary: #4f4043;
        --color-text-muted: #66575a;
        --color-liga-primera: #8c1d3a;
        --color-liga-ascenso: #8c1d3a;
        --color-liga-ascenso-dim: #6d132c;
        --color-holder: #75152f;
        --color-holder-bg: #f2dfe4;
        --palmares-header-ink: #fffdf8;
        --badge-on-accent: #fffdf8;
        --match-meta-accent: #e7a9b8;
        --score-bg: #21191b;
        --score-border: #21191b;
        --score-color: #fffdf8;
        --score-secondary: #e6d7d9;
      }

      .milad-hero {
        position: relative;
        overflow: hidden;
        background: var(--color-bg-primary) !important;
        border-bottom: 1px solid var(--color-text-primary);
        color: var(--color-text-primary);
      }

      .milad-hero::after {
        content: none;
      }

      .hero-pattern {
        position: absolute;
        right: clamp(1.25rem, 8vw, 9rem);
        top: -6rem;
        width: clamp(13rem, 28vw, 23rem);
        aspect-ratio: 1;
        border: 1px solid rgba(217, 21, 63, 0.5);
        transform: rotate(45deg);
        pointer-events: none;
      }

      .hero-pattern::before,
      .hero-pattern::after {
        position: absolute;
        inset: 15%;
        border: 1px solid rgba(13, 12, 11, 0.16);
        content: "";
      }

      .hero-pattern::after {
        inset: 32%;
        border-color: rgba(217, 21, 63, 0.5);
      }

      .page-hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 2rem;
        position: relative;
        z-index: 1;
      }

      .page-hero-label {
        display: block;
        margin: 0 0 1.25rem !important;
        padding: 0 !important;
        background: transparent !important;
        color: #a20d2e !important;
        font-size: 0.68rem !important;
        letter-spacing: 0.16em !important;
      }

      .page-hero-title {
        max-width: 10ch;
        color: #0d0c0b !important;
        font-size: clamp(4.3rem, 10vw, 8.5rem) !important;
        letter-spacing: -0.07em !important;
        line-height: 0.8 !important;
      }

      .page-hero-desc {
        max-width: 55ch;
        margin: 1.6rem 0 0 !important;
        color: #4e4e4a !important;
        font-size: clamp(1rem, 1.5vw, 1.15rem) !important;
      }

      .page-hero-desc strong {
        color: #a20d2e;
      }

      .holder-note {
        display: grid;
        grid-template-columns: auto auto;
        column-gap: 0.8rem;
        align-items: center;
        min-width: 12rem;
        padding: 0.8rem 0 0.8rem 1rem;
        border-left: 3px solid #d9153f;
      }

      .holder-note-label,
      .section-kicker {
        color: var(--color-text-muted);
        font-family: var(--font-body);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .holder-note-label {
        grid-column: 1 / -1;
        margin-bottom: 0.25rem;
      }

      .holder-note-name {
        color: #0d0c0b;
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 0.95;
        text-transform: uppercase;
      }

      .holder-note-logo {
        grid-column: 2;
        grid-row: 2;
        border: 1px solid #cfcec6;
        object-fit: contain;
      }

      .palmares-section {
        margin-top: clamp(2.5rem, 6vw, 5rem);
      }

      .palmares-section :global(section) {
        margin-top: 0.65rem;
      }

      .section-kicker {
        margin: 0;
      }

      .season-nav {
        display: flex;
        gap: 0;
        justify-content: flex-start;
        margin: clamp(3rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
        border-bottom: 1px solid #cfcec6;
        overflow-x: auto;
      }

      .season-tab {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
        min-width: 7.5rem;
        padding: 0.8rem 1rem 0.7rem;
        border-bottom: 3px solid transparent;
        color: #777772;
        cursor: pointer;
        transition: color 180ms ease, border-color 180ms ease, background-color 180ms ease;
      }

      .tab-year {
        font-family: var(--font-display);
        font-size: 1.65rem;
        letter-spacing: -0.03em;
        line-height: 1;
      }

      .tab-count {
        font-family: var(--font-body);
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
      }

      .season-tab:hover {
        background: #e9e8e2;
        color: #0d0c0b;
      }

      .season-tab.active {
        border-color: #d9153f;
        color: #a20d2e;
      }

      .season-tab.active .tab-count {
        color: var(--color-liga-ascenso-dim);
        opacity: 1;
      }

      .season-section {
        margin-bottom: 5rem;
      }

      .season-section.hidden {
        display: none;
      }

      .season-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 2rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid #0d0c0b;
      }

      .season-title {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin: 0;
      }

      .season-year {
        color: #0d0c0b;
        font-size: clamp(2.1rem, 4vw, 3.5rem);
        letter-spacing: -0.05em;
      }

      .season-stats {
        display: flex;
        gap: 0;
      }

      .mini-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 4.3rem;
        padding: 0.25rem 0.55rem;
        border-left: 1px solid #cfcec6;
      }

      .mini-stat-num {
        font-family: var(--font-display);
        font-size: 1.4rem;
        color: #a20d2e;
        line-height: 1;
      }

      .mini-stat-label {
        font-family: var(--font-body);
        font-size: 0.55rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
      }

      .season-chain {
        margin-bottom: 1.5rem;
      }

      .matches-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .season-tab:focus-visible {
        outline-color: #a20d2e;
        outline-offset: -3px;
      }

      @media (max-width: 700px) {
        .milad-hero {
          min-height: auto;
        }

        .page-hero-inner {
          grid-template-columns: 1fr;
          gap: 2.25rem;
        }

        .page-hero-title {
          font-size: clamp(3.8rem, 17vw, 5.4rem) !important;
        }

        .holder-note {
          width: min(100%, 17rem);
        }

        .season-nav {
          margin-top: 3rem;
        }

        .season-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 1.25rem;
        }

        .season-stats {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          width: 100%;
        }

        .mini-stat {
          min-width: 0;
          padding: 0.35rem 0.25rem;
        }

        .mini-stat-num {
          font-size: 1.1rem;
        }

        .mini-stat-label {
          font-size: clamp(0.6rem, 2vw, 0.68rem);
        }
      }
    </style>
</Layout>
