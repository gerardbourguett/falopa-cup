---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import MatchCard from "../../components/MatchCard.astro";
import Palmares from "../../components/Palmares.astro";
import HolderChain from "../../components/HolderChain.astro";
import { SITE_TITLE } from "../../consts";
import { getHolderChain } from "../../lib/tournament";

const cupEntries = await getCollection("falopa-cup");
const clubsEntries = await getCollection("clubs");

const clubById = new Map(clubsEntries.map((e) => [e.data.id || e.id, e.data]));

function normalizeMatches(matches: any[]) {
  return matches.map((m: any) => ({
    ...m,
    date: m.date instanceof Date ? m.date : new Date(m.date),
  }));
}

function matchKey(m: any): string {
  const d = m.date instanceof Date ? m.date.toISOString() : String(m.date);
  return `${m.type}-${d}-${m.holderId}-${m.challengerId}-${m.scoreHolder}-${m.scoreChallenger}`;
}

function findDivergenceIndex(a: any[], b: any[]): number {
  const len = Math.min(a.length, b.length);
  for (let i = 0; i < len; i++) {
    if (matchKey(a[i]) !== matchKey(b[i])) return i;
  }
  return len;
}

const entriesByYear = new Map<number, typeof cupEntries>();
for (const e of cupEntries) {
  const yr = e.data.year;
  if (!entriesByYear.has(yr)) entriesByYear.set(yr, []);
  entriesByYear.get(yr)!.push(e);
}

type Branch = {
  label: string;
  matches: any[];
  championReason?: string;
  whatIf?: any[];
};
type Season = {
  year: number;
  branches: Branch[] | null;
  sharedMatches: any[];
  allUniqueMatches: any[];
};

const seasons: Season[] = [...entriesByYear.entries()]
  .map(([year, entries]) => {
    if (entries.length === 1) {
      const matches = normalizeMatches(entries[0].data.matches);
      return {
        year,
        branches: null,
        sharedMatches: matches,
        allUniqueMatches: matches,
      };
    }

    const branches: Branch[] = entries.map((e) => ({
      label: e.data.branch || "Rama",
      matches: normalizeMatches(e.data.matches),
      championReason: e.data.championReason,
      whatIf: e.data.whatIf ? normalizeMatches(e.data.whatIf) : undefined,
    }));

    const divIdx = findDivergenceIndex(
      branches[0].matches,
      branches[1].matches,
    );
    const shared = branches[0].matches.slice(0, divIdx);
    const branchAOnly = branches[0].matches.slice(divIdx);
    const branchBOnly = branches[1].matches.slice(divIdx);

    return {
      year,
      branches,
      sharedMatches: shared,
      allUniqueMatches: [...shared, ...branchAOnly, ...branchBOnly],
    };
  })
  .sort((a, b) => b.year - a.year);

const currentSeason = seasons[0];
const allMatches = seasons.flatMap((s) => s.allUniqueMatches);

function countTitleChanges(matches: any[]) {
  return matches.filter(
    (m) => m.status !== "pending" && m.type === "match" && m.newHolderId && m.newHolderId !== m.holderId,
  ).length;
}

function countHolders(matches: any[]) {
  return new Set(matches.filter((m) => m.status !== "pending" && m.newHolderId).map((m) => m.newHolderId))
    .size;
}

function countDefenses(matches: any[]) {
  return matches.filter(
    (m) => m.status !== "pending" && m.type === "match" && m.newHolderId === m.holderId,
  ).length;
}

function seasonMatchCount(s: Season): number {
  return s.allUniqueMatches.filter((m) => m.status !== "pending").length;
}

function getBranchMatches(s: Season, branchIdx: number): any[] {
  if (!s.branches) return [];
  const divIdx = findDivergenceIndex(
    s.branches[0].matches,
    s.branches[1].matches,
  );
  return s.branches[branchIdx].matches.slice(divIdx);
}

function getChampionId(matches: any[]): string | undefined {
  for (let i = matches.length - 1; i >= 0; i--) {
    if (matches[i].status === "pending") continue;
    if (matches[i].newHolderId) return matches[i].newHolderId;
    if (matches[i].holderId) return matches[i].holderId;
  }
  return undefined;
}

const currentHolder = currentSeason
  ? getChampionId(currentSeason.allUniqueMatches)
  : undefined;
const currentHolderClub = currentHolder ? clubById.get(currentHolder) : undefined;
---

<Layout
  title={SITE_TITLE}
  description="Historial completo de la Falopa Cup, el campeonato no oficial del futbol chileno."
  currentPath="/falopa-cup"
  image="/og/falopa-cup.svg"
>
  <div class="falopa-page">
    <section class="page-hero falopa-hero" aria-labelledby="falopa-title">
      <div class="hero-pattern" aria-hidden="true"></div>
      <div class="page-hero-inner">
        <div class="hero-copy">
          <p class="page-hero-label">Campeonato no oficial del fútbol chileno</p>
          <h1 class="page-hero-title" id="falopa-title">Falopa Cup</h1>
          <p class="page-hero-desc">
            El título se defiende en cada partido oficial. Si quien lo defiende
            <strong>pierde</strong>, cambia de manos.
          </p>
        </div>
        <aside class="holder-note" aria-label="Poseedor actual de la Falopa Cup">
          <span class="holder-note-label">Poseedor actual</span>
          <span class="holder-note-name">
            {currentHolderClub?.name || currentHolder || "Por definir"}
          </span>
          {currentHolderClub?.logo && (
            <img
              src={currentHolderClub.logo}
              alt=""
              width="44"
              height="44"
              class="holder-note-logo"
            />
          )}
        </aside>
      </div>
    </section>

    <main class="container">
      <section class="palmares-section" aria-label="Palmarés histórico">
        <p class="section-kicker">Registro acumulado</p>
        <Palmares
          allMatches={allMatches}
          clubs={clubById}
          accentColor="gold"
          currentHolderId={currentHolder}
        />
      </section>

    <!-- Season Tabs -->
    <nav class="season-nav" id="season-nav" aria-label="Temporadas Falopa Cup">
      {
        seasons.map((season) => (
          <a
            href={`#season-${season.year}`}
            class:list={[
              "season-tab",
              { active: season.year === currentSeason?.year },
            ]}
            data-year={season.year}
            aria-current={season.year === currentSeason?.year ? "page" : undefined}
          >
            <span class="tab-year">{season.year}</span>
            <span class="tab-count">{seasonMatchCount(season)} P</span>
          </a>
        ))
      }
    </nav>

    <!-- Seasons -->
    {
      seasons.map((season) => (
        <section
          id={`season-${season.year}`}
          class:list={[
            "season-section",
            { hidden: season.year !== currentSeason?.year },
          ]}
          data-season={season.year}
        >
          <header class="season-header">
            <div>
              <p class="section-kicker">Bitácora de la copa</p>
              <h2 class="season-title">
                <span class="season-year">Temporada {season.year}</span>
              </h2>
            </div>
            <div class="season-stats">
              <div class="mini-stat">
                <span class="mini-stat-num">{seasonMatchCount(season)}</span>
                <span class="mini-stat-label">Partidos</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat-num">
                  {countTitleChanges(season.allUniqueMatches)}
                </span>
                <span class="mini-stat-label">Cambios</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat-num">
                  {countDefenses(season.allUniqueMatches)}
                </span>
                <span class="mini-stat-label">Defensas</span>
              </div>
              <div class="mini-stat">
                <span class="mini-stat-num">
                  {countHolders(season.allUniqueMatches)}
                </span>
                <span class="mini-stat-label">Poseedores</span>
              </div>
            </div>
          </header>

          {/* Holder Chain for this season */}
          {(() => {
            const chain = getHolderChain(season.allUniqueMatches);
            return chain.length > 0 ? (
              <div class="season-chain">
                <HolderChain
                  chain={chain}
                  clubs={clubById}
                  accentColor="gold"
                  caption={`Cadena de poseedores · Falopa Cup ${season.year}`}
                />
              </div>
            ) : null;
          })()}

          {season.branches ? (
            <>
              <div class="matches-list">
                {season.sharedMatches.map((match: any, index: number) => (
                  <MatchCard match={match} clubs={clubById} index={index} />
                ))}
              </div>

              <div class="cisma-divider">
                <div class="cisma-line" />
                <span class="cisma-label">El Cisma</span>
                <div class="cisma-line" />
              </div>

              {season.branches.map((branch, bIdx) => {
                const branchMatches = getBranchMatches(season, bIdx);
                const baseIdx = season.sharedMatches.length;
                const championId = getChampionId(branchMatches);
                const champion = championId
                  ? clubById.get(championId)
                  : undefined;
                return (
                  <div class="branch-section">
                    <div class="branch-header">
                      <span class="branch-icon">
                        {bIdx === 0 ? "\u25C0" : "\u25B6"}
                      </span>
                      <h3 class="branch-title">{branch.label}</h3>
                      <span class="branch-count">
                        {branchMatches.length} partidos
                      </span>
                    </div>
                    <div class="matches-list">
                      {branchMatches.map((match: any, index: number) => (
                        <MatchCard
                          match={match}
                          clubs={clubById}
                          index={baseIdx + index}
                        />
                      ))}
                    </div>

                    {champion && (
                      <div class="branch-champion">
                        <span class="champion-trophy">&#9733;</span>
                        <div class="champion-info">
                          <span class="champion-label">Campeón de la rama</span>
                          <div class="champion-club">
                            {champion.logo && (
                              <img
                                src={champion.logo}
                                alt={champion.name}
                                class="champion-logo"
                                width="32"
                                height="32"
                              />
                            )}
                            <span class="champion-name">{champion.name}</span>
                          </div>
                          {branch.championReason && (
                            <span class="champion-reason">
                              {branch.championReason}
                            </span>
                          )}
                        </div>
                      </div>
                    )}

                    {branch.whatIf && branch.whatIf.length > 0 && (
                      <details class="whatif-section">
                        <summary class="whatif-toggle">
                          <span class="whatif-icon">&#9881;</span>
                          <span>What if...?</span>
                          <span class="whatif-count">
                            {branch.whatIf.length} partidos hipoteticos
                          </span>
                        </summary>
                        <div class="whatif-body">
                          <p class="whatif-desc">
                            Si el título se hubiera seguido rastreando por esta
                            rama...
                          </p>
                          <div class="matches-list whatif-matches">
                            {branch.whatIf.map((match: any, index: number) => (
                              <MatchCard
                                match={match}
                                clubs={clubById}
                                index={index}
                              />
                            ))}
                          </div>
                        </div>
                      </details>
                    )}
                  </div>
                );
              })}
            </>
          ) : (
            <div class="matches-list">
              {season.sharedMatches.map((match: any, index: number) => (
                <MatchCard match={match} clubs={clubById} index={index} />
              ))}
            </div>
          )}
        </section>
      ))
    }
    </main>
  </div>
</Layout>

<script>
  function initTabs() {
    const nav = document.getElementById("season-nav");
    if (!nav) return;

    const tabs = nav.querySelectorAll<HTMLAnchorElement>(".season-tab");
    const sections = document.querySelectorAll<HTMLElement>(".season-section");

    function seasonIdToYear(hashValue: string) {
      return hashValue.replace("#", "").replace("season-", "");
    }

    function showSeason(year: string) {
      tabs.forEach((t) => {
        const isTarget = t.dataset.year === year;
        t.classList.toggle("active", isTarget);
        if (isTarget) {
          t.setAttribute("aria-current", "page");
        } else {
          t.removeAttribute("aria-current");
        }
      });
      sections.forEach((s) => {
        const isTarget = s.dataset.season === year;
        s.classList.toggle("hidden", !isTarget);
      });
      history.replaceState(null, "", `#season-${year}`);
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        if (tab.dataset.year) showSeason(tab.dataset.year);
      });
    });

    const hash = seasonIdToYear(window.location.hash);
    if (hash && document.querySelector(`[data-season="${hash}"]`)) {
      showSeason(hash);
    }

    window.addEventListener("hashchange", () => {
      const nextHash = seasonIdToYear(window.location.hash);
      if (nextHash && document.querySelector(`[data-season="${nextHash}"]`)) {
        showSeason(nextHash);
      }
    });
  }

  initTabs();
  document.addEventListener("astro:after-swap", initTabs);
</script>

<noscript>
  <style>
    .season-section.hidden {
      display: block !important;
    }
  </style>
</noscript>

<style>

  /* ── Tema de la Falopa Cup ──────────────────────────────────────────
     Misma arquitectura que la Copa Pablo Milad: la pagina redefine los
     tokens en su propio scope, asi el shell y los componentes compartidos
     se pintan solos. Milad va en burdeos sobre papel rosado; esta va en
     naranja quemado sobre papel ambar.
     Todos los pares pasan WCAG AA; el acento da 7.18:1 como texto, contra
     los 3.00:1 del naranja de marca original. */
  .falopa-page {
    --color-bg-primary: #f8f4ec;
    --color-bg-secondary: #fffdf8;
    --color-bg-tertiary: #f2eadd;
    --color-bg-elevated: #cfc2ae;
    --color-text-primary: #1b1613;
    --color-text-secondary: #4c4239;
    --color-text-muted: #665a4e;
    --color-liga-primera: #8f3410;
    --color-liga-primera-dim: #6f2708;
    --color-liga-ascenso: #8f3410;
    --color-liga-ascenso-dim: #6f2708;
    --color-holder: #7a2c0c;
    --color-holder-bg: #f7e4d2;
    --palmares-header-ink: #fffdf8;
    --badge-on-accent: #fffdf8;
    --match-meta-accent: #e8b795;
    --score-bg: #1b1613;
    --score-border: #1b1613;
    --score-color: #fffdf8;
    --score-secondary: #eddcc9;
  }

  /* El shell global pinta los heroes de negro con !important; esta pagina
     lo invierte a papel claro y anula su overlay decorativo. */
  .falopa-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-primary) !important;
    border-bottom: 1px solid var(--color-text-primary);
    color: var(--color-text-primary);
  }

  .falopa-hero::after { content: none; }

  .hero-pattern {
    position: absolute;
    right: clamp(1.25rem, 8vw, 9rem);
    top: -6rem;
    width: clamp(13rem, 28vw, 23rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-liga-primera) 50%, transparent);
    transform: rotate(45deg);
    pointer-events: none;
  }

  .hero-pattern::before,
  .hero-pattern::after {
    position: absolute;
    inset: 15%;
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 16%, transparent);
    content: "";
  }

  .hero-pattern::after {
    inset: 32%;
    border-color: color-mix(in srgb, var(--color-liga-primera) 50%, transparent);
  }

  .page-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .page-hero-label {
    display: block;
    margin: 0 0 1.25rem !important;
    padding: 0 !important;
    background: transparent !important;
    color: var(--color-liga-primera) !important;
    font-size: 0.68rem !important;
    letter-spacing: 0.16em !important;
  }

  .page-hero-title {
    max-width: 10ch;
    color: var(--color-text-primary) !important;
    font-size: clamp(4.3rem, 10vw, 8.5rem) !important;
    letter-spacing: -0.07em !important;
    line-height: 0.8 !important;
  }

  .page-hero-desc {
    max-width: 55ch;
    margin: 1.6rem 0 0 !important;
    color: var(--color-text-secondary) !important;
    font-size: clamp(1rem, 1.5vw, 1.15rem) !important;
  }

  .page-hero-desc strong { color: var(--color-liga-primera); }

  .holder-note {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 0.8rem;
    align-items: center;
    min-width: 12rem;
    padding: 0.8rem 0 0.8rem 1rem;
    border-left: 3px solid var(--color-liga-primera);
  }

  .holder-note-label,
  .section-kicker {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .holder-note-label {
    grid-column: 1 / -1;
    margin-bottom: 0.25rem;
  }

  .holder-note-name {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .holder-note-logo {
    grid-column: 2;
    grid-row: 2;
    border: 1px solid var(--color-bg-elevated);
    object-fit: contain;
  }

  .palmares-section { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .palmares-section :global(section) { margin-top: 0.65rem; }
  .section-kicker { margin: 0; }

  .season-nav {
    display: flex;
    gap: 0;
    justify-content: flex-start;
    margin: clamp(3rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-bg-elevated);
    overflow-x: auto;
  }

  .season-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-width: 7.5rem;
    padding: 0.8rem 1rem 0.7rem;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .tab-year {
    font-family: var(--font-display);
    font-size: 1.65rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tab-count {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .season-tab:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  .season-tab.active {
    border-color: var(--color-liga-primera);
    color: var(--color-liga-primera);
  }

  .season-tab.active .tab-count {
    color: var(--color-liga-primera-dim);
    opacity: 1;
  }

  .season-tab:focus-visible {
    outline-color: var(--color-liga-primera);
    outline-offset: -3px;
  }

  .season-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-text-primary);
  }

  .season-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .season-year {
    color: var(--color-text-primary);
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    letter-spacing: -0.05em;
  }

  .season-stats {
    display: flex;
    gap: 0;
  }

  .mini-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.3rem;
    padding: 0.25rem 0.55rem;
    background: transparent;
    border: none;
    border-left: 1px solid var(--color-bg-elevated);
    border-radius: 0;
  }

  .mini-stat-num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-liga-primera);
    line-height: 1;
  }

  .mini-stat-label {
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .falopa-hero { min-height: auto; }

    .page-hero-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .page-hero-title { font-size: clamp(3.8rem, 17vw, 5.4rem) !important; }

    .holder-note { width: min(100%, 17rem); }

    .season-nav { margin-top: 3rem; }

    .season-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .season-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      width: 100%;
    }

    .mini-stat {
      min-width: 0;
      padding: 0.35rem 0.25rem;
    }

    .mini-stat-num { font-size: 1.1rem; }
    .mini-stat-label { font-size: clamp(0.6rem, 2vw, 0.68rem); }
  }

  @media (max-width: 420px) {
    .season-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* === PAGE HERO === */

  /* === SEASON NAV === */




  .season-tab:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border-color: var(--color-liga-primera);
  }

  .season-tab.active {
    background: var(--color-bg-tertiary);
    color: var(--color-liga-primera-dim);
    border-color: var(--color-liga-primera);
  }

  .season-tab.active .tab-count {
    color: var(--color-liga-primera-dim);
    opacity: 0.7;
  }

  /* === SEASON SECTION === */
  .season-section {
    margin-bottom: 3rem;
  }

  .season-section.hidden {
    display: none;
  }








  .season-chain {
    margin-bottom: 1.5rem;
  }

  .matches-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* === CISMA DIVIDER === */
  .cisma-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0;
  }

  .cisma-line {
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-liga-ascenso) 0,
      var(--color-liga-ascenso) 8px,
      transparent 8px,
      transparent 14px
    );
    opacity: 0.5;
  }

  .cisma-label {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
