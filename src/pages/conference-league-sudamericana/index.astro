          <p class="phase-head-note">
            {round.description || `${round.ties.length} ${round.ties.length === 1 ? 'llave' : 'llaves'} a puntaje fantasy acumulado.`}
          </p>
        </header>
        <div class="round-grid">
          {round.ties.map((tie: any) => {
            const a = slotIdentity(tie.slotA);
            const b = slotIdentity(tie.slotB);
