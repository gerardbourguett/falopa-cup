                </header>
                {[{ who: a, id: tie.slotA.clubId, score: tie.scoreA, slot: tie.slotA }, { who: b, id: tie.slotB.clubId, score: tie.scoreB, slot: tie.slotB }].map((side: any) => (
                  <div
                    class:list={['round-side', !side.who.resolved && 'is-open', tie.winnerClubId === side.id && 'is-winner']}
