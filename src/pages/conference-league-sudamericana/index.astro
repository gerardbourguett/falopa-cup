---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { SITE_TITLE } from '../../consts';
import {
  buildFantasyByClub,
  buildFantasyStandingsByGroup,
  buildMatchSourceMap,
  buildTieResolutionDetail,
  buildWindowCutRanking,
  buildWindowCutReviewBuckets,
  buildWindowCutWithFantasy,
  getWindowCutCardDeductions,
  type ConferenceGroupDefinition,
  type RoundWindowData,
  type WindowCutEntry,
} from '../../lib/tournaments/conference-league-sudamericana';
import {
  getClubAccentColor,
  getEntryTypeSportLabel,
} from '../../lib/tournaments/conference-league-sudamericana/club-visuals';

const entries = await getCollection('conference-league-sudamericana');

const clubsDoc = entries.find((entry) => entry.data.kind === 'clubs')?.data as any;
const stageDoc = entries.find((entry) => entry.data.kind === 'stage')?.data as any;
const groupsDoc = entries.find((entry) => entry.data.kind === 'groups')?.data as any;
const windowCutDoc = entries.find((entry) => entry.data.kind === 'window-cut')?.data as any;
const knockoutDoc = entries.find((entry) => entry.data.kind === 'knockout')?.data as any;

const seedById = new Map<string, any>(
  (clubsDoc?.seeds || []).map((seed: any) => [seed.clubId, seed] as [string, any])
);

const countryNames: Record<string, string> = {
  AR: 'Argentina',
  BO: 'Bolivia',
  BR: 'Brasil',
  CL: 'Chile',
  CO: 'Colombia',
  EC: 'Ecuador',
  PY: 'Paraguay',
  PE: 'Perú',
  UY: 'Uruguay',
  VE: 'Venezuela',
};

function flagClass(country: string) {
  return `fi fi-${String(country || '').toLowerCase()}`;
}

function formatRoundDate(value: string | Date) {
  const date = value instanceof Date ? value : new Date(value);
  return date.toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit' });
}

function getSeed(clubId: string) {
  return seedById.get(clubId);
}

function allocationLabel(category?: string) {
  switch (category) {
    case 'league-direct': return 'Directo por cupo país';
    case 'coefficient-direct': return 'Directo por coeficiente';
    case 'preliminary-pot-1': return 'Bombo 1 por coeficiente';
    case 'preliminary-pot-2': return 'Bombo 2 por coeficiente';
    default: return 'Sin categoría editorial';
  }
}

function knockoutSlotLabel(slot: any) {
  if (slot.label) return slot.label;
  if (slot.clubId) return clubMeta(slot.clubId).name;
  const groupMatch = String(slot.sourceRef).match(/^group-([A-H])-(1|2)$/);
  if (groupMatch) return `${groupMatch[2] === '1' ? '1º' : '2º'} Grupo ${groupMatch[1]}`;
  const eliminatedMatch = String(slot.sourceRef).match(/sudamericana-eliminated-(\d+)/);
  if (eliminatedMatch) return `Eliminado Sudamericana ${eliminatedMatch[1]}`;
  return `Ganador ${slot.sourceRef}`;
}

function clubMeta(clubId: string) {
  const seed = getSeed(clubId);
  const country = seed?.country || '--';
  return {
    clubId,
    name: seed?.name || clubId,
    country,
    countryName: countryNames[country] || country,
    accent: getClubAccentColor(clubId),
    entryType: seed?.entryType || 'base',
    entryTypeLabel: getEntryTypeSportLabel(seed?.entryType),
    coefficient: seed?.conmebolCoefficient ?? null,
    coefficientLabel: seed?.coefficientLabel || 'SR',
    allocationCategory: seed?.allocationCategory,
    allocationLabel: allocationLabel(seed?.allocationCategory),
  };
}

const preliminaryTies = stageDoc?.preliminaryTies || [];

const preliminaryPotAIds = stageDoc?.preliminaryPot1Ids || [];
const preliminaryPotBIds = stageDoc?.preliminaryPot2Ids || [];
const preliminaryPotA = preliminaryPotAIds.map((clubId: string) => clubMeta(clubId));
const preliminaryPotB = preliminaryPotBIds.map((clubId: string) => clubMeta(clubId));
const potASet = new Set(preliminaryPotA.map((club: any) => club.clubId));
const potBSet = new Set(preliminaryPotB.map((club: any) => club.clubId));

function potLabel(clubId: string) {
  if (potASet.has(clubId)) return 'B1';
  if (potBSet.has(clubId)) return 'B2';
  return '—';
}

const tieCards = preliminaryTies.map((tie: any) => {
  const clubA = clubMeta(tie.clubAId);
  const clubB = clubMeta(tie.clubBId);
  const hasScore = Number.isFinite(tie.scoreA) && Number.isFinite(tie.scoreB);
  const winnerName =
    tie.winnerClubId === tie.clubAId ? clubA.name
    : tie.winnerClubId === tie.clubBId ? clubB.name
    : null;
  return {
    ...tie,
    clubA,
    clubB,
    potA: potLabel(tie.clubAId),
    potB: potLabel(tie.clubBId),
    hasScore,
    scoreLabel: hasScore ? `${tie.scoreA}–${tie.scoreB}` : '—',
    winnerName,
  };
});

// Groups data
const groups = (groupsDoc?.groups || []) as ConferenceGroupDefinition[];
const totalClubs = (clubsDoc?.seeds || []).length;
const groupCount = ((groupsDoc?.groups || []) as ConferenceGroupDefinition[]).length;
const groupStageClubs = (stageDoc?.mainStageQualifiedIds || []).length;

// Estado del torneo: una sola lectura de en que fase estamos hoy.
// Se deriva de los propios documentos; no hay estados escritos a mano.
const preliminaryResolved = tieCards.filter((tie: any) => tie.hasScore).length;
const phaseTimeline = [
  {
    id: 'previa',
    name: 'Fase previa',
    status: tieCards.length > 0 && preliminaryResolved === tieCards.length ? 'completed' : 'in-progress',
    detail: `${preliminaryResolved}/${tieCards.length} llaves`,
  },
  {
    id: 'grupos',
    name: 'Fase de grupos',
    status: (groupsDoc?.roundWindows || []).length >= 3 ? 'completed' : 'in-progress',
    detail: `${(groupsDoc?.roundWindows || []).length} fechas`,
  },
  ...((knockoutDoc?.rounds || []) as any[]).map((round: any) => ({
    id: round.id,
    name: round.name,
    status: round.status,
    detail: `${round.ties.length} ${round.ties.length === 1 ? 'llave' : 'llaves'}`,
  })),
];
const currentPhase = phaseTimeline.find((phase: any) => phase.status !== 'completed');
const PHASE_ANCHORS: Record<string, string> = {
  previa: 'fase-previa',
  grupos: 'fase-grupos',
  'KO-PLAYOFF': 'fase-playoff',
  'KO-R16': 'fase-octavos',
  'KO-QF': 'fase-cuartos',
  'KO-SF': 'fase-semifinales',
  'KO-F': 'fase-final',
};
const phaseNav = phaseTimeline.map((phase: any) => ({
  ...phase,
  anchor: PHASE_ANCHORS[phase.id] || phase.id.toLowerCase(),
  isCurrent: currentPhase?.id === phase.id,
}));
const roundWindows = (groupsDoc?.roundWindows || []) as RoundWindowData[];
const fantasyByClub = buildFantasyByClub(roundWindows);
const fantasyStandingsByGroup = buildFantasyStandingsByGroup(groups, fantasyByClub, clubMeta);
const matchSourceMap = buildMatchSourceMap(roundWindows);
const playoffRound = knockoutDoc?.rounds?.find((round: any) => round.id === 'KO-PLAYOFF');
const roundOf16 = knockoutDoc?.rounds?.find((round: any) => round.id === 'KO-R16');
const finalBracketRounds = (knockoutDoc?.rounds || []).filter((round: any) => round.id !== 'KO-PLAYOFF');
const knockoutTieById = new Map<string, any>(
  (knockoutDoc?.rounds || []).flatMap((round: any) => round.ties || []).map((tie: any) => [tie.id, tie] as [string, any]),
);

// Las etiquetas de los eliminados de Sudamericana traen el pais en tres letras
// ("Caracas (VEN)") porque esos clubes no estan en seeds y no tienen ficha propia.
const TRI_TO_ISO: Record<string, string> = {
  ARG: 'AR', BOL: 'BO', BRA: 'BR', CHI: 'CL', COL: 'CO',
  ECU: 'EC', PAR: 'PY', PER: 'PE', URU: 'UY', VEN: 'VE',
};

// Identidad completa de un slot del cuadro: nombre, bandera y color, resuelto o no.
// Sustituye a bracketSlotLabel cuando hace falta pintar el club, no solo nombrarlo.
function slotIdentity(slot: any): any {
  if (!slot) return { name: '—', country: '', accent: '', resolved: false };

  if (slot.sourceType === 'tie-winner') {
    const sourceTie = knockoutTieById.get(slot.sourceRef);
    if (sourceTie?.winnerClubId) {
      const won =
        sourceTie.slotA.clubId === sourceTie.winnerClubId ? sourceTie.slotA :
        sourceTie.slotB.clubId === sourceTie.winnerClubId ? sourceTie.slotB : null;
      if (won) return { ...slotIdentity(won), from: slot.sourceRef };
    }
    if (slot.clubId) return { ...slotIdentity({ ...slot, sourceType: 'resolved' }), from: slot.sourceRef };
    return { name: knockoutSlotLabel(slot), country: '', accent: '', resolved: false, from: slot.sourceRef };
  }

  const seed = slot.clubId ? seedById.get(slot.clubId) : null;
  if (seed) {
    return {
      name: seed.name,
      country: seed.country,
      accent: getClubAccentColor(slot.clubId),
      clubId: slot.clubId,
      resolved: true,
    };
  }

  if (slot.label) {
    const match = String(slot.label).match(/^(.*?)\s*\(([A-Z]{3})\)$/);
    return {
      name: match ? match[1] : slot.label,
      country: match ? (TRI_TO_ISO[match[2]] || '') : '',
      accent: slot.clubId ? getClubAccentColor(slot.clubId) : '',
      clubId: slot.clubId,
      resolved: true,
    };
  }

  return { name: knockoutSlotLabel(slot), country: '', accent: '', clubId: slot.clubId, resolved: false };
}

function bracketSlotLabel(slot: any) {
  if (slot.sourceType !== 'tie-winner') return knockoutSlotLabel(slot);
  const sourceTie = knockoutTieById.get(slot.sourceRef);
  if (!sourceTie?.winnerClubId) return knockoutSlotLabel(slot);
  if (sourceTie.slotA.clubId === sourceTie.winnerClubId) return knockoutSlotLabel(sourceTie.slotA);
  if (sourceTie.slotB.clubId === sourceTie.winnerClubId) return knockoutSlotLabel(sourceTie.slotB);
  return knockoutSlotLabel(slot);
}
const roundOf16ByPlayoff = new Map<string, any>(
  (roundOf16?.ties || []).map((tie: any) => [tie.slotB.sourceRef, tie] as [string, any]),
);

// Audit data
const windowCutRows = ((windowCutDoc?.entries || []) as WindowCutEntry[]).map((entry: WindowCutEntry) => ({
  ...entry,
  ...clubMeta(entry.clubId),
}));

const windowCutRanking = buildWindowCutRanking(windowCutRows);

const windowCutNoMatch = windowCutRows.filter((entry: any) => entry.status === 'no-match');
const windowCutWithFantasy = buildWindowCutWithFantasy(windowCutRows);
const windowCutByClubId = new Map<string, any>(
  windowCutWithFantasy.map((entry: any) => [entry.clubId, entry] as [string, any])
);

const preliminaryWikiRows = tieCards.map((tie: any) => ({
  ...tie,
  sourceA: windowCutByClubId.get(tie.clubAId),
  sourceB: windowCutByClubId.get(tie.clubBId),
  resolutionDetail: buildTieResolutionDetail(windowCutByClubId.get(tie.clubAId), windowCutByClubId.get(tie.clubBId)),
}));

const reviewBuckets = buildWindowCutReviewBuckets(windowCutWithFantasy);
const reviewNoMatch = reviewBuckets.noMatch;
const reviewNonEspn = reviewBuckets.nonEspn;
const reviewAdministrativeTies = preliminaryWikiRows.filter((t: any) => t.resolvedBy === 'administrative');
const reviewMissingCards = reviewBuckets.missingCards;
---

<Layout
  title={`Conference League Sudamericana — ${SITE_TITLE}`}
  description="Torneo fantasy por ventanas: edición 2026"
  currentPath="/conference-league-sudamericana"
  image="/og/conference-league-sudamericana.svg"
>
  <section class="page-hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="eyebrow">Conference League Sudamericana</p>
        <h1>Edición <span class="hero-year">2026</span></h1>
        <p class="hero-sub">
          {totalClubs} clubes · {groupStageClubs} en fase de grupos · {groupCount} grupos · {roundWindows.length} fechas fantasy · acumulación pura
        </p>
      </div>
      <div class="hero-stat-bar">
        <div class="hero-stat"><span class="hero-stat-num">{totalClubs}</span><span class="hero-stat-label">Clubes en la edición</span></div>
        <div class="hero-stat"><span class="hero-stat-num">{groupStageClubs}</span><span class="hero-stat-label">En fase de grupos</span></div>
        <div class="hero-stat"><span class="hero-stat-num">{roundWindows.length}</span><span class="hero-stat-label">Fechas fantasy</span></div>
        <div class="hero-stat"><span class="hero-stat-num">{groupCount}</span><span class="hero-stat-label">Grupos</span></div>
      </div>
    </div>
  </section>

  <div class="container page-nav-strip">
    <a href="/conference-league-sudamericana/wiki" class="page-nav-tab">Wiki</a>
    <a href="/conference-league-sudamericana" class="page-nav-tab active" aria-current="page">Resultados</a>
  </div>

  <main class="container page-main">

    <!-- ===== NAVEGADOR DE FASES ===== -->
    <nav class="phase-nav" aria-label="Fases del torneo">
      <p class="phase-nav-status">
        {!currentPhase
          ? 'Torneo finalizado'
          : currentPhase.status === 'in-progress'
            ? `En curso · ${currentPhase.name}`
            : `Próxima ronda · ${currentPhase.name}`}
      </p>
      <ol class="phase-nav-list">
        {phaseNav.map((phase: any) => (
          <li>
            <a
              href={`#${phase.anchor}`}
              class:list={['phase-chip', `is-${phase.status}`, phase.isCurrent && 'is-current']}
              aria-current={phase.isCurrent ? 'step' : undefined}
            >
              <span class="phase-chip-name">{phase.name}</span>
              <span class="phase-chip-detail">{phase.detail}</span>
              <span class="phase-chip-state">
                {phase.status === 'completed' ? 'Cerrada' : phase.status === 'in-progress' ? 'En curso' : 'Pendiente'}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>


    <!-- ===== FASE PREVIA ===== -->
    <section class="phase-section" id="fase-previa">
      <header class="phase-head">
        <h2>Fase previa</h2>
        <span class:list={['phase-state-chip', preliminaryResolved === tieCards.length ? 'is-completed' : 'is-live']}>
          {preliminaryResolved}/{tieCards.length} llaves resueltas
        </span>
        <p class="phase-head-note">
          Cruces de ida y vuelta entre los clubes de bombo 1 y bombo 2. Los ganadores entran al sorteo de grupos.
        </p>
      </header>
        <div class="ties-grid">
          {tieCards.map((tie: any) => (
            <article class="tie-card">
              <header class="tie-header">
                <span class="tie-id">{tie.id}</span>
                <div class="tie-result">
                  {tie.hasScore ? (
                    <>
                      <span class="tie-score">{tie.scoreLabel}</span>
                      <small class="tie-winner">{tie.winnerName ? `→ ${tie.winnerName}` : ''}</small>
                    </>
                  ) : <span class="tie-pending">pendiente</span>}
                </div>
              </header>

              <div class:list={['tie-club', 'club-accent', tie.winnerClubId === tie.clubAId && 'winner']} style={`--club-accent:${tie.clubA.accent}`}>
                <div class="tie-club-main">
                  <span class:list={['club-flag-icon', flagClass(tie.clubA.country)]} aria-hidden="true"></span>
                  <span>{tie.clubA.name}</span>
                </div>
                <small>{tie.potA} · {tie.clubA.coefficientLabel}</small>
              </div>

              <div class:list={['tie-club', 'club-accent', tie.winnerClubId === tie.clubBId && 'winner']} style={`--club-accent:${tie.clubB.accent}`}>
                <div class="tie-club-main">
                  <span class:list={['club-flag-icon', flagClass(tie.clubB.country)]} aria-hidden="true"></span>
                  <span>{tie.clubB.name}</span>
                </div>
                <small>{tie.potB} · {tie.clubB.coefficientLabel}</small>
              </div>
            </article>
          ))}
        </div>
    </section>


    <!-- ===== FASE DE GRUPOS ===== -->
    <section class="phase-section" id="fase-grupos">
      <header class="phase-head">
        <h2>Fase de grupos</h2>
        <span class:list={['phase-state-chip', roundWindows.length >= 3 ? 'is-completed' : 'is-live']}>
          {roundWindows.length} de 3 fechas
        </span>
        <p class="phase-head-note">
          {groupStageClubs} clubes en {groupCount} grupos. Cada club acumula puntaje fantasy a partir de los partidos
          oficiales que juega dentro de la ventana de cada fecha; no hay enfrentamientos directos.
        </p>
      </header>

    <div class="block-groups">
      {roundWindows.length > 0 && (
        <div class="round-tabs">
          {roundWindows.map((rw: any) => (
            <span class="round-tab active">{rw.roundId} · {rw.windowStart} – {rw.windowEnd}</span>
          ))}
        </div>
      )}

      <div class="groups-grid">
        {groups.map((group: any) => {
          const standings = fantasyStandingsByGroup.get(group.group) || group.clubIds.map((id: string) => ({ ...clubMeta(id), clubId: id, played: 0, base: 0, bonus: 0, penalty: 0, total: 0 }));
          return (
            <article class="group-card" data-group={group.group}>
              <h3 class="group-title">Grupo {group.group}</h3>
              <table class="standings-table">
                <thead>
                  <tr>
                    <th class="col-pos">#</th>
                    <th class="col-club">Club</th>
                    <th title="Partidos jugados">PJ</th>
                    <th title="Base: V(3) E(1) D(0)">Base</th>
                    <th title="Bonus: Arco en cero + Margen progresivo" class="col-bonus">+B</th>
                    <th title="Penal: Derrota amplia + Tarjetas" class="col-penal">−P</th>
                    <th title="Fantasy total acumulado" class="col-fx">FX</th>
                  </tr>
                </thead>
                <tbody>
                  {standings.map((row: any, idx: number) => {
                    const isLeader = idx === 0 && row.played > 0;
                    return (
                      <tr class:list={[isLeader && 'row-leader']}>
                        <td class="col-pos">{idx + 1}</td>
                        <td class="col-club">
                          <span class="inline-club club-accent" style={`--club-accent:${row.accent}`}>
                            <span class:list={['club-flag-icon', flagClass(row.country)]} aria-hidden="true"></span>
                            <span class="club-name-text" title={row.name}>{row.name}</span>
                          </span>
                        </td>
                        <td>{row.played}</td>
                        <td>{row.base}</td>
                        <td class="col-bonus">{row.bonus > 0 ? `+${row.bonus}` : row.bonus}</td>
                        <td class="col-penal">{row.penalty < 0 ? row.penalty : row.penalty}</td>
                        <td class:list={['col-fx', row.total > 0 ? 'fx-pos' : row.total < 0 ? 'fx-neg' : '']}>{row.total}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <div class="standings-legend">
                <span title="Victoria 3 · Empate 1 · Derrota 0">Base: V3 E1 D0</span>
                <span title="Arco en cero (+1) + Margen progresivo (+N−1)">+B: AEC + Margen</span>
                <span title="Derrota amplia (−1) + Amarillas (−0.25) + Rojas (−1)">−P: DA + Tarj</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>


      <div class="phase-subhead">
        <h3>Partidos por fecha</h3>
        <span>
          {roundWindows.reduce((total: number, round: any) => total + (round.windowMatchSources?.length || 0), 0)} registros
        </span>
      </div>

      <div class="date-tabs" role="tablist" aria-label="Fechas fantasy">
        {roundWindows.map((round: any, index: number) => (
          <button
            type="button"
            class:list={['date-tab', index === 0 && 'active']}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-${round.roundId}`}
            id={`tab-${round.roundId}`}
            data-round-tab={round.roundId}
          >
            <strong>{round.roundId.replace('GS-', '')}</strong>
            <small>{formatRoundDate(round.windowStart)} → {formatRoundDate(round.windowEnd)}</small>
          </button>
        ))}
      </div>
      <p class="counted-help">
        <strong>Cuenta:</strong> suma al puntaje fantasy de la fecha. <strong>No puntúa:</strong> se conserva como respaldo editorial y auditoría, pero no modifica la tabla.
      </p>

      {roundWindows.map((round: any, roundIndex: number) => (
        <div
          class:list={['date-panel', roundIndex !== 0 && 'hidden']}
          role="tabpanel"
          id={`panel-${round.roundId}`}
          aria-labelledby={`tab-${round.roundId}`}
          data-round-panel={round.roundId}
        >
          <div class="round-window-note">
            <strong>{round.roundId}</strong>
            <span>Ventana {round.windowStart} – {round.windowEnd}</span>
            <span>Extensión hasta {round.extendedWindowEnd}</span>
            <span>{round.windowMatchSources?.length || 0} partidos registrados</span>
          </div>

          <div class="f1-groups">
            {groups.map((group: any) => {
              const clubIds = group.clubIds as string[];
              return (
                <div class="f1-group">
                  <h3 class="f1-group-title">Grupo {group.group}</h3>
                  <div class="f1-club-list">
                    {clubIds.map((id: string) => {
                      const club = clubMeta(id);
                      const matches = matchSourceMap.get(round.roundId)?.get(id) || [];
                      const noSecondMatch = (round.clubsWithoutSecondMatch || []).find(
                        (entry: any) => entry.clubId === id,
                      );
                      const allMs = matches.map((ms: any) => {
                        const fx = (round.fantasyScores || []).find((fs: any) => fs.sourceMatchId === ms.id);
                        return { ...ms, fx };
                      });
                      const clubTotal = allMs.reduce(
                        (sum: number, source: any) => sum + (source.counted ? source.fx?.total || 0 : 0),
                        0,
                      );
                      const isPlayed = (ms: any) => ms.status === 'played' || (ms.goalsFor != null && ms.goalsAgainst != null);
                      return (
                        <div class="f1-club">
                          <div class="f1-club-header">
                            <span class="inline-club club-accent" style={`--club-accent:${club.accent}`}>
                              <span class:list={['club-flag-icon', flagClass(club.country)]} aria-hidden="true"></span>
                              <strong>{club.name}</strong>
                            </span>
                            <span class:list={['f1-club-total', clubTotal > 0 ? 'fx-pos' : clubTotal < 0 ? 'fx-neg' : '']}>{clubTotal} pts</span>
                          </div>
                          <div class="f1-matches">
                            {allMs.length === 0 && <p class="f1-empty">Sin partidos cargados en esta fecha.</p>}
                            {allMs.map((s: any) => (
                              <div class:list={['f1-match', !isPlayed(s) && 'f1-match-scheduled', !s.counted && 'f1-match-reference']}>
                                {isPlayed(s) ? (
                                  <>
                                    <span class="f1-match-score">{s.goalsFor}–{s.goalsAgainst}</span>
                                    <span class="f1-match-cond">{s.isHome ? 'L' : 'V'}</span>
                                    <span class="f1-match-vs">vs {s.isHome ? s.awayClub : s.homeClub}</span>
                                    <span class="f1-match-comp">
                                      {s.sourceCompetition} · {new Date(s.sourceDate).toLocaleDateString('es-AR', { day: 'numeric', month: 'short' })}
                                      {s.yellowCards != null && s.yellowCards > 0 && <span class="f1-cards"> · TA:{s.yellowCards}</span>}
                                      {s.redCards != null && s.redCards > 0 && <span class="f1-cards f1-cards-red"> · TR:{s.redCards}</span>}
                                    </span>
                                    <span class:list={['f1-counted', s.counted ? 'is-counted' : '']}>
                                      {s.counted ? 'Cuenta' : 'No puntúa'}
                                    </span>
                                    {s.fx && (
                                      <span class:list={['f1-match-fx', s.fx.total >= 3 ? 'fx-pos' : s.fx.total < 0 ? 'fx-neg' : '']} title={s.fx.explanation}>
                                        {s.fx.total >= 0 ? '+' : ''}{s.fx.total}
                                      </span>
                                    )}
                                    {s.fx?.explanation && <small class="f1-breakdown">{s.fx.explanation}</small>}
                                    {s.sourceUrl && (
                                      <a class="f1-source" href={s.sourceUrl} target="_blank" rel="noreferrer">
                                        Ver fuente ↗
                                      </a>
                                    )}
                                  </>
                                ) : (
                                  <>
                                    <span class="f1-match-date">{new Date(s.sourceDate).toLocaleDateString('es-AR', { day: 'numeric', month: 'short' })}</span>
                                    <span class="f1-match-cond">{s.isHome ? 'L' : 'V'}</span>
                                    <span class="f1-match-vs">vs {s.isHome ? s.awayClub : s.homeClub}</span>
                                    <span class="f1-match-comp">{s.sourceCompetition}</span>
                                    <span class="f1-match-pending">{s.status === 'tbd' ? 'TBD' : 'por jugar'}</span>
                                  </>
                                )}
                              </div>
                            ))}
                            {noSecondMatch && (
                              <div class="f1-no-second-match">
                                <strong>Ventana cerrada con un partido</strong>
                                <span>{noSecondMatch.reason}</span>
                                {noSecondMatch.sourceUrl && (
                                  <a href={noSecondMatch.sourceUrl} target="_blank" rel="noreferrer">
                                    Ver siguiente partido en junio ↗
                                  </a>
                                )}
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}

    </section>

    <!-- ===== PLAYOFF ===== -->
    <section class="phase-section" id="fase-playoff">
      <header class="phase-head">
        <h2>Playoff eliminatorio</h2>
        <span class:list={['phase-state-chip', playoffRound?.status === 'completed' ? 'is-completed' : 'is-live']}>
          {playoffRound?.status === 'completed' ? 'Cerrado' : 'En juego'}
        </span>
        <p class="phase-head-note">
          Los ocho segundos de grupo, ordenados de mejor a peor puntaje fantasy, contra los ocho eliminados de la Copa
          Sudamericana. Cada club suma dos partidos y el mejor total fantasy pasa a octavos.
        </p>
      </header>

      <div class="po-grid">
        {(playoffRound?.ties || []).map((tie: any) => {
          const a = slotIdentity(tie.slotA);
          const b = slotIdentity(tie.slotB);
          const complete = tie.matchesPlayedA === 2 && tie.matchesPlayedB === 2;
          const sides = [
            { id: tie.slotA.clubId, who: a, score: tie.scoreA, played: tie.matchesPlayedA, gf: tie.goalsForA, dg: tie.goalDifferenceA, cs: tie.cleanSheetsA, cards: tie.cardDeductionsA },
            { id: tie.slotB.clubId, who: b, score: tie.scoreB, played: tie.matchesPlayedB, gf: tie.goalsForB, dg: tie.goalDifferenceB, cs: tie.cleanSheetsB, cards: tie.cardDeductionsB },
          ];
          return (
            <article class:list={['po-tie', complete && 'is-final']}>
              <header class="po-tie-head">
                <span class="po-tie-id">{tie.id}</span>
                <span class="po-tie-state">{complete ? 'Resultado final' : 'Puntaje provisional'}</span>
              </header>
              {sides.map((side: any) => (
                <div
                  class:list={['po-side', tie.winnerClubId === side.id && 'is-winner']}
                  style={side.who.accent ? `--club-accent:${side.who.accent}` : undefined}
                >
                  <div class="po-side-club">
                    {side.who.country && (
                      <span class:list={['club-flag-icon', flagClass(side.who.country)]} aria-hidden="true"></span>
                    )}
                    <span class="po-side-name" title={side.who.name}>{side.who.name}</span>
                  </div>
                  <span class="po-side-fx">{Number.isFinite(side.score) ? side.score : '—'}</span>
                  <dl class="po-side-stats">
                    <div><dt>PJ</dt><dd>{side.played ?? 0}/2</dd></div>
                    <div><dt>GF</dt><dd>{side.gf ?? 0}</dd></div>
                    <div><dt>DG</dt><dd>{side.dg > 0 ? `+${side.dg}` : side.dg ?? 0}</dd></div>
                    <div><dt>AEC</dt><dd>{side.cs ?? 0}</dd></div>
                    <div><dt>Tarj</dt><dd>−{side.cards ?? 0}</dd></div>
                  </dl>
                </div>
              ))}
              {tie.winnerClubId && (
                <footer class="po-tie-foot">
                  Clasifica <strong>{tie.winnerClubId === tie.slotA.clubId ? a.name : b.name}</strong>
                  {tie.tiebreakReason && <span> · {tie.tiebreakReason}</span>}
                </footer>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <!-- ===== CUADRO FINAL ===== -->
    <section class="phase-section" id="cuadro-final">
      <header class="phase-head">
        <h2>Cuadro final</h2>
        <span class="phase-state-chip is-planned">Octavos a la final</span>
        <p class="phase-head-note">
          Los ocho primeros de grupo, ordenados por puntaje, contra los ocho ganadores del playoff en el mismo orden.
        </p>
      </header>

      <div class="bracket-viewport" aria-label="Cuadro eliminatorio desde octavos hasta la final">
        <div class="bracket-flow">
          {finalBracketRounds.map((round: any) => (
            <div class="bracket-col">
              <div class="bracket-col-head">
                <span>{round.name}</span>
                <small>{round.ties.length} {round.ties.length === 1 ? 'llave' : 'llaves'}</small>
              </div>
              <div class="bracket-col-body">
                {round.ties.map((tie: any) => {
                  const a = slotIdentity(tie.slotA);
                  const b = slotIdentity(tie.slotB);
                  const hasScore = Number.isFinite(tie.scoreA) && Number.isFinite(tie.scoreB);
                  return (
                    <div class="bracket-slot">
                      <article class:list={['bracket-tie', tie.winnerClubId && 'is-resolved']}>
                        <span class="bracket-tie-id">{tie.id}</span>
                        {[{ who: a, id: tie.slotA.clubId, score: tie.scoreA }, { who: b, id: tie.slotB.clubId, score: tie.scoreB }].map((side: any) => (
                          <div
                            class:list={['bracket-side', !side.who.resolved && 'is-open', tie.winnerClubId === side.id && 'is-winner']}
                            style={side.who.accent ? `--club-accent:${side.who.accent}` : undefined}
                          >
                            {side.who.country
                              ? <span class:list={['club-flag-icon', flagClass(side.who.country)]} aria-hidden="true"></span>
                              : <span class="bracket-flag-empty" aria-hidden="true"></span>}
                            <span class="bracket-side-name" title={side.who.name}>{side.who.name}</span>
                            <span class="bracket-side-fx">{hasScore ? side.score : '—'}</span>
                          </div>
                        ))}
                      </article>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
      <p class="bracket-hint">Desplazá el cuadro para ver las rondas siguientes.</p>
    </section>

    {finalBracketRounds.map((round: any) => (
      <section class="phase-section" id={PHASE_ANCHORS[round.id] || round.id.toLowerCase()}>
        <header class="phase-head">
          <h2>{round.name}</h2>
          <span class:list={['phase-state-chip', round.status === 'completed' ? 'is-completed' : round.status === 'in-progress' ? 'is-live' : 'is-planned']}>
            {round.status === 'completed' ? 'Cerrada' : round.status === 'in-progress' ? 'En curso' : 'Pendiente'}
