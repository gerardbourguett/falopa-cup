  }

  .phase-chip-detail {
    font-size: 0.66rem;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .phase-chip-state {
    font-family: var(--font-display);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .phase-chip.is-completed .phase-chip-state { color: var(--color-conference-dim); }
  .phase-chip.is-current .phase-chip-state { color: var(--color-liga-primera-dim); }

  /* ================= SECCION DE FASE ================= */
  .phase-section { scroll-margin-top: calc(var(--site-header-h, 0px) + var(--phase-nav-h, 0px) + 1rem); }

  .phase-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-text-primary);
  }

  .phase-head h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .phase-head-note {
    grid-column: 1 / -1;
    max-width: 62ch;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .phase-state-chip {
    justify-self: end;
    padding: 0.22rem 0.5rem;
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-primary);
    background: var(--color-bg-elevated);
  }

  .phase-state-chip.is-completed { background: var(--color-conference); color: var(--color-text-primary); }
  .phase-state-chip.is-live { background: var(--color-liga-primera); color: var(--color-text-primary); }
  .phase-state-chip.is-planned { background: var(--color-bg-elevated); color: var(--color-text-secondary); }

  .phase-subhead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 2.5rem 0 1rem;
    padding-left: 0.7rem;
    border-left: 4px solid var(--color-conference);
  }

  .phase-subhead h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
  }

  .phase-subhead span {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ================= PLAYOFF ================= */
  .po-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 0.85rem;
  }

  .po-tie {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-bg-elevated);
  }

  .po-tie-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--color-bg-elevated);
  }

  .po-tie-id {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .po-tie-state {
    font-family: var(--font-display);
    font-size: 0.58rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .po-tie.is-final .po-tie-state { color: var(--color-conference-dim); }

  .po-side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.3rem 0.6rem;
    padding: 0.55rem 0.6rem 0.55rem 0.75rem;
    border-left: 3px solid var(--club-accent, var(--color-bg-elevated));
  }

  .po-side + .po-side { border-top: 1px solid var(--color-bg-elevated); }

  .po-side.is-winner { background: var(--color-conference-tint); }

  .po-side-club {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .po-side-name {
    min-width: 0;
    overflow: hidden;
    font-weight: 600;
    font-size: 0.85rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .po-side.is-winner .po-side-name { color: var(--color-conference-dim); }

  .po-side-fx {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .po-side-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    grid-column: 1 / -1;
    margin: 0;
  }

  .po-side-stats > div { display: flex; gap: 0.2rem; align-items: baseline; }

  .po-side-stats dt {
    font-family: var(--font-display);
    font-size: 0.55rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .po-side-stats dd {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .po-tie-foot {
    padding: 0.45rem 0.6rem;
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    background: var(--color-bg-tertiary);
    border-top: 1px solid var(--color-bg-elevated);
  }

  .po-tie-foot strong { color: var(--color-text-primary); }

  /* ================= CUADRO CON CONECTORES ================= */
  .bracket-viewport {
    --bk-stub: 1.15rem;
    --bk-gap: 2.3rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.5rem;
  }

  .bracket-flow {
    display: flex;
    gap: var(--bk-gap);
    min-width: min-content;
    min-height: 30rem;
  }

  .bracket-col {
    display: flex;
    flex-direction: column;
    flex: 0 0 13.5rem;
  }

  .bracket-col-head {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-bottom: 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-bg-elevated);
  }

  .bracket-col-head span {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bracket-col-head small { font-size: 0.62rem; color: var(--color-text-muted); }

  .bracket-col-body { display: flex; flex-direction: column; flex: 1; }

  /* Cada slot ocupa una fraccion igual de la columna, asi la ronda siguiente
     cae sola en el punto medio del par que la alimenta. Sin calculo de pitch. */
  .bracket-slot {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
  }

  .bracket-slot::before,
  .bracket-slot::after {
    position: absolute;
    background: var(--color-bg-elevated);
    content: '';
  }

  /* tramo horizontal de salida */
  .bracket-col:not(:last-child) .bracket-slot::before {
    left: 100%;
    top: 50%;
    width: var(--bk-stub);
    height: 1px;
  }

  /* union vertical del par */
  .bracket-col:not(:last-child) .bracket-slot::after {
    left: calc(100% + var(--bk-stub));
    width: 1px;
  }

  .bracket-col:not(:last-child) .bracket-slot:nth-child(odd)::after { top: 50%; bottom: 0; }
  .bracket-col:not(:last-child) .bracket-slot:nth-child(even)::after { top: 0; bottom: 50%; }

  .bracket-tie {
    position: relative;
    width: 100%;
    min-width: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-bg-elevated);
  }

  /* tramo horizontal de entrada */
  .bracket-col:not(:first-child) .bracket-tie::before {
    position: absolute;
    right: 100%;
    top: 50%;
    width: var(--bk-stub);
    height: 1px;
    background: var(--color-bg-elevated);
    content: '';
  }

  .bracket-tie.is-resolved { border-color: var(--color-conference-dim); }

  .bracket-tie-id {
    display: block;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-bg-elevated);
  }

  .bracket-side {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.5rem;
    border-left: 3px solid var(--club-accent, transparent);
  }

  .bracket-side + .bracket-side { border-top: 1px solid var(--color-bg-elevated); }
  .bracket-side.is-winner { background: var(--color-conference-tint); }
  .bracket-side.is-open { color: var(--color-text-muted); font-style: normal; }

  .bracket-side-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.74rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bracket-side.is-open .bracket-side-name { font-weight: 400; }

  .bracket-side-fx {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .bracket-flag-empty {
    width: 1.05rem;
    height: 0.78rem;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-bg-elevated) 0 3px,
      transparent 3px 6px
    );
  }

  .bracket-hint {
    margin: 0.5rem 0 0;
    font-size: 0.66rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .bracket-hint { display: none; }
  }

  /* ================= LLAVES POR RONDA ================= */
  .round-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
  }

  .round-tie {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-bg-elevated);
    transition: border-color 0.15s;
  }

  .round-tie:hover { border-color: var(--color-text-muted); }
  .round-tie.is-resolved { border-color: var(--color-conference-dim); }

  .round-tie-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    font-family: var(--font-display);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-bg-elevated);
  }

  .round-tie-head small {
    font-size: 0.58rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .round-side {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.6rem;
    border-left: 3px solid var(--club-accent, transparent);
  }

  .round-side + .round-side { border-top: 1px solid var(--color-bg-elevated); }
  .round-side.is-winner { background: var(--color-conference-tint); }
  .round-side.is-open { color: var(--color-text-muted); }

  .round-side-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.85rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .round-side.is-open .round-side-name { font-weight: 400; }

  .round-side-from {
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .round-side-fx {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .phase-head { grid-template-columns: minmax(0, 1fr); }
    .phase-state-chip { justify-self: start; }
    .bracket-col { flex-basis: 11.5rem; }
  }


  /* ── Blocks ── */
  .block {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-bg-elevated);
    border-radius: 2px;
    padding: 1.25rem;
  }

  /* ── Estado del torneo: la primera lectura de la pagina ── */




  .phase-name {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .phase-detail {
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .phase-state {
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }


  /* ── Ritmo: las secciones principales respiran, la pila de auditoria se agrupa ── */
  .deep-data-divider {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: -1.4rem;
    padding-left: 0.75rem;
    border-left: 4px solid var(--color-text-muted);
  }

  .deep-data-divider span {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .deep-data-divider small {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .audit-block + .audit-block { margin-top: calc(-1 * var(--stack-gap) + 0.35rem); }

  .block-groups {
    background: transparent;
    border: none;
    padding: 0;
    /* Break out of container on wide screens */
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    padding-left: max(2rem, calc((100vw - 1600px) / 2));
    padding-right: max(2rem, calc((100vw - 1600px) / 2));
    box-sizing: border-box;
  }

  .block h2 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding-left: 0.75rem;
    border-left: 4px solid var(--color-conference);
  }

  .section-header h2 {
    margin: 0;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.1rem;
  }

  .section-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-conference);
    background: transparent;
    border: 1px solid var(--color-conference);
    border-radius: 2px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
    font-weight: 600;
    font-family: var(--font-display);
  }

  .round-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .round-tab {
    font-size: 0.72rem;
    font-family: var(--font-display);
    background: transparent;
    border: 1px solid var(--color-bg-elevated);
    border-radius: 2px;
    padding: 0.25rem 0.6rem;
    color: var(--color-text-muted);
  }

  .round-tab.active {
    background: var(--color-conference);
    border-color: var(--color-conference);
    color: #000;
    font-weight: 600;
  }

  /* ── Groups grid: broadcast panels ── */
  .groups-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-bg-elevated);
  }

  @media (min-width: 1100px) {
    .groups-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }


  .group-card {
    background: var(--color-bg-secondary);
    padding: 0.9rem;
    overflow: hidden;
    position: relative;
    border-radius: 0;
    border: none;
    transition: background 0.15s;
  }

  .group-card::before {
    content: attr(data-group);
    position: absolute;
    right: 0.3rem;
    top: -0.3rem;
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-conference);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
  }

  .group-card:hover {
    background: color-mix(in srgb, var(--color-bg-secondary) 95%, var(--color-conference));
  }

  .group-title {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-conference);
    font-weight: 700;
    font-family: var(--font-display);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-bg-elevated);
  }

  /* ── Standings table ── */
  .standings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    position: relative;
  }

  .standings-table th {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-align: center;
    padding: 0.25rem 0.15rem;
    border-bottom: 1px solid var(--color-bg-elevated);
    font-weight: 400;
  }

  .standings-table th.col-club { text-align: left; }

  /* La columna de club absorbe el sobrante; las numericas se quedan en su minimo.
     Sin esto el nombre necesitaba un max-width fijo y se truncaba de forma silenciosa. */
  .standings-table th.col-club,
  .standings-table td.col-club { width: 100%; }
  .standings-table th:not(.col-club):not(.col-pos),
  .standings-table td:not(.col-club):not(.col-pos) { width: 1%; white-space: nowrap; }

  .standings-table td {
    padding: 0.4rem 0.15rem;
    text-align: center;
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg-elevated) 50%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .standings-table tr:last-child td { border-bottom: none; }
  .standings-table td.col-club { text-align: left; }

  .standings-table td.col-pos {
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-family: var(--font-display);
    width: 1.2rem;
  }

  .standings-table td.col-pts {
    font-family: var(--font-display);
    font-size: 0.88rem;
  }

  .standings-table td.col-pts strong { color: var(--color-text-primary); }

  /* FX es el total del torneo: debe pesar mas que Base/+B/-P, no menos. */
  .standings-table th.col-fx { color: var(--color-text-primary); font-weight: 700; }

  .standings-table td.col-fx {
    font-size: 0.95rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text-primary);
    border-left: 1px solid var(--color-bg-elevated);
    padding-left: 0.35rem;
  }

  .standings-table td.col-bonus { color: var(--color-conference); font-size: 0.72rem; }
  .standings-table td.col-penal { color: #e05252; font-size: 0.72rem; }

  .standings-table td.fx-pos { color: var(--color-conference); font-weight: 700; }
  .standings-table td.fx-neg { color: #e05252; font-weight: 700; }

  .standings-table tr.row-leader {
    background: var(--color-conference-tint);
  }

  .standings-table tr.row-leader td.col-pos {
    color: var(--color-conference);
    font-weight: 700;
  }

  .inline-club {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    max-width: 100%;
  }

  .inline-club.club-accent {
    border-left: 2px solid var(--club-accent, var(--color-text-muted));
    padding-left: 0.3rem;
  }

  .club-name-text {
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    max-width: 100%;
    display: inline-block;
    vertical-align: middle;
  }

  .round-score-chips {
    display: inline-flex;
    gap: 2px;
    margin-left: 0.25rem;
  }

  .score-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 2px;
    font-size: 0.65rem;
    font-weight: 600;
    font-family: var(--font-display);
    cursor: default;
  }

  .chip-win    { background: var(--color-conference); color: #000; }
  .chip-draw   { background: #c9a800; color: #000; }
  .chip-loss   { background: #e05252; color: #000; }
  .chip-pending { background: var(--color-bg-elevated); color: var(--color-text-muted); }

  /* ── Club flag ── */
  .club-flag-icon {
    width: 1rem;
    height: 0.75rem;
    border-radius: 1px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  /* ── Preliminary ties ── */
  .ties-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2px;
    background: var(--color-bg-elevated);
  }

  .tie-card {
    background: var(--color-bg-secondary);
    padding: 0.7rem 0.8rem;
    border-radius: 0;
  }

  .tie-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
  }

  .tie-id {
    font-size: 0.65rem;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .tie-result {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }

  .tie-score {
