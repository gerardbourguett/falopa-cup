          <li><strong>Clubes sin tarjetas cargadas:</strong> {reviewMissingCards.length ? reviewMissingCards.map((e: any) => e.name).join(', ') : 'ninguno'}</li>
        </ul>
      </div>
    </details>

  </main>
</Layout>

<script>
  function initRoundTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-round-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-round-panel]');

    function activateRound(roundId: string) {
      tabs.forEach((tab) => {
        const active = tab.dataset.roundTab === roundId;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.roundPanel !== roundId);
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        if (tab.dataset.roundTab) activateRound(tab.dataset.roundTab);
      });

      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        if (next.dataset.roundTab) activateRound(next.dataset.roundTab);
        next.focus();
      });
    });
  }

  // El header del sitio es sticky y su alto depende del viewport, asi que se mide
  // en vez de hardcodearlo: de ahi cuelgan el top del nav de fases y el scroll-margin.
  function syncStickyOffsets() {
    const header = document.querySelector<HTMLElement>('header');
    const phaseNav = document.querySelector<HTMLElement>('.phase-nav');
    const root = document.documentElement;
    if (header) root.style.setProperty('--site-header-h', `${Math.round(header.getBoundingClientRect().height)}px`);
    if (phaseNav) root.style.setProperty('--phase-nav-h', `${Math.round(phaseNav.getBoundingClientRect().height)}px`);
  }

  initRoundTabs();
  syncStickyOffsets();
  window.addEventListener('resize', syncStickyOffsets);
  document.addEventListener('astro:after-swap', () => {
    initRoundTabs();
    syncStickyOffsets();
  });
</script>

