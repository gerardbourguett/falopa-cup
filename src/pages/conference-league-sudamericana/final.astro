---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { SITE_TITLE } from '../../consts';
import { getClubAccentColor } from '../../lib/tournaments/conference-league-sudamericana/club-visuals';
import {
  FINAL_WINDOW_START,
  buildFinalClubTotal,
  resolveFinalResult,
} from '../../lib/tournaments/conference-league-sudamericana/finals';
import {
  buildSemifinalClubTotal,
  semifinalFantasyScore,
} from '../../lib/tournaments/conference-league-sudamericana/semifinals';

const entries = await getCollection('conference-league-sudamericana');
const byKind = (kind: string) => entries.find((entry) => entry.data.kind === kind)?.data as any;
const clubsDoc = byKind('clubs');
const knockoutDoc = byKind('knockout');
const sfDoc = byKind('sf-window');
const fDoc = byKind('f-window');

const finalRound = knockoutDoc.rounds.find((round: any) => round.id === 'KO-F');
const tie = finalRound.ties[0];
const semifinalRound = knockoutDoc.rounds.find((round: any) => round.id === 'KO-SF');

const countryNames: Record<string, string> = {
  BO: 'Bolivia', BR: 'Brasil', CL: 'Chile', CO: 'Colombia', EC: 'Ecuador',
  PY: 'Paraguay', PE: 'Perú', UY: 'Uruguay', VE: 'Venezuela', AR: 'Argentina',
};
const seedById = new Map<string, any>((clubsDoc?.seeds || []).map((seed: any) => [seed.clubId, seed]));
const clubMeta = (clubId: string) => {
  const seed = seedById.get(clubId);
  return {
    clubId,
    name: seed?.name || clubId,
    country: countryNames[seed?.country] || seed?.country || '',
    flag: `fi fi-${String(seed?.country || '').toLowerCase()}`,
    accent: getClubAccentColor(clubId),
  };
};

const formatScore = (value: number) => String(value);
const finalists = [tie.slotA, tie.slotB].map((slot: any) => {
  const plan = fDoc.clubs.find((club: any) => club.clubId === slot.clubId);
  const total = buildFinalClubTotal(plan);
  const semifinalPlan = sfDoc.clubs.find((club: any) => club.clubId === slot.clubId);
  const semifinalTotal = buildSemifinalClubTotal(semifinalPlan);
  const opponentSlot = slot === tie.slotA ? tie.slotB : tie.slotA;
  const semifinalTie = semifinalRound.ties.find((candidate: any) => candidate.id === slot.sourceRef);
  const semifinalRivalId = [semifinalTie.slotA.clubId, semifinalTie.slotB.clubId].find((id: string) => id !== slot.clubId);
  const rivalPlan = sfDoc.clubs.find((club: any) => club.clubId === semifinalRivalId);
  return {
    ...clubMeta(slot.clubId),
    plan,
    total,
    semifinalTotal,
    semifinalRival: { ...clubMeta(semifinalRivalId), total: buildSemifinalClubTotal(rivalPlan) },
    opponentId: opponentSlot.clubId,
  };
});
const result = resolveFinalResult(finalists[0].plan, finalists[1].plan);
const champion = result.winnerClubId ? finalists.find((club) => club.clubId === result.winnerClubId) : null;
const playedCount = finalists.reduce((sum, club) => sum + club.total.played, 0);
const statusLabel = champion ? 'Campeón definido' : playedCount > 0 ? 'En juego' : 'Por jugar';
const statusClass = champion ? 'is-completed' : playedCount > 0 ? 'is-live' : 'is-planned';

function totalLabel(club: (typeof finalists)[number]) {
  if (club.total.total == null) return '—';
  return `${club.total.disciplinePending ? '≤ ' : ''}${formatScore(club.total.total)}${club.total.disciplinePending ? '*' : ''}`;
}
function progressText(club: (typeof finalists)[number]) {
  const played = club.total.played;
  if (played === 0) return 'Sin partidos jugados';
  return played === 1 ? '1 de 2 partidos jugados' : '2 de 2 partidos jugados';
}
function dateLabel(fixture: any) {
  if (!fixture.sourceDate) return 'Fecha por confirmar';
  const date = new Date(`${fixture.sourceDate}T12:00:00Z`);
  return date.toLocaleDateString('es-CL', { weekday: 'short', day: '2-digit', month: '2-digit', timeZone: 'UTC' }).replace('.', '');
}
function timeLabel(fixture: any) {
  if (fixture.startTimestamp == null) return 'Hora por confirmar';
  return new Date(fixture.startTimestamp * 1000).toLocaleTimeString('es-CL', {
    timeZone: fixture.timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
  });
}
function fixtureStatus(fixture: any) {
  if (fixture.status === 'played') return { label: 'Jugado', cls: 'is-played' };
  if (fixture.status === 'tbd') return { label: 'Por confirmar', cls: 'is-tbd' };
  if (fixture.selectionStatus === 'provisional') return { label: 'Programado · provisional', cls: 'is-provisional' };
  return { label: 'Programado', cls: 'is-scheduled' };
}
const simulatorClubs = finalists.map((club) => ({
  clubId: club.clubId,
  name: club.name,
  baseTotal: club.total.total ?? 0,
  basePlayed: club.total.played,
  disciplinePending: club.total.disciplinePending,
}));
const simulableSlots = (club: (typeof finalists)[number]) => club.plan.fixtures
  .map((fixture: any, index: number) => ({ fixture, index }))
  .filter(({ fixture }: any) => fixture.status !== 'played');
const marginOptions = [1, 2, 3, 4, 5];
const slotScore = (club: (typeof finalists)[number], fixture: any) => semifinalFantasyScore(club.clubId, fixture, FINAL_WINDOW_START);
const windowStartLabel = new Date(`${FINAL_WINDOW_START}T12:00:00Z`).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', timeZone: 'UTC' });
---

<Layout
  title={`La final · Conference League Sudamericana — ${SITE_TITLE}`}
  description={`Alianza Lima contra Metropolitanos: los dos partidos de cada finalista y el total fantasy en vivo.`}
  currentPath="/conference-league-sudamericana"
>
  <section class="final-hero" aria-labelledby="final-title">
    <div class="container final-hero-inner">
      <a class="final-back" href="/conference-league-sudamericana#cuadro-final">← Conference League Sudamericana</a>
      <div class="final-title-row">
        <h1 id="final-title">La final</h1>
        <span class={`final-chip ${statusClass}`}>{statusLabel}</span>
      </div>
      <p class="final-lede">
        {finalists[0].name} contra {finalists[1].name}. Cada finalista suma sus dos próximos partidos oficiales
        desde el {windowStartLabel}, sin fecha límite: gana el mayor total fantasy verificado.
      </p>

      <div class="final-board" role="group" aria-label="Marcador de la final">
        {finalists.map((club, index) => (
          <>
            {index === 1 && <div class="final-versus" aria-hidden="true">vs</div>}
            <article
              class:list={['final-side', champion?.clubId === club.clubId && 'is-champion']}
              style={`--club-accent:${club.accent}`}
              aria-label={`${club.name}: total ${totalLabel(club)}`}
            >
              <header class="final-side-head">
                <span class={`club-flag-icon ${club.flag}`} aria-hidden="true"></span>
                <div class="final-side-name">
                  <h2>{club.name}</h2>
                  <span class="final-side-country">{club.country}</span>
                </div>
              </header>
              <p class:list={['final-total', club.total.total == null && 'is-empty']} aria-live="polite">{club.total.total == null ? 'Sin puntos' : totalLabel(club)}</p>
              <p class="final-total-note">
                {club.total.total == null ? 'El total aparece al jugarse el primer partido' : club.total.played < 2 ? 'Total fantasy parcial' : club.total.disciplinePending ? 'Máximo provisional (tarjetas sin verificar)' : 'Total fantasy verificado'}
              </p>
              <div class="final-pips" role="img" aria-label={progressText(club)}>
                <span class:list={['pip', club.total.played >= 1 && 'is-on']}></span>
                <span class:list={['pip', club.total.played >= 2 && 'is-on']}></span>
                <span class="final-pips-text">{progressText(club)}</span>
              </div>
              {champion?.clubId === club.clubId && <p class="final-crown">Campeón de la Conference 2026</p>}
            </article>
          </>
        ))}
      </div>
    </div>
  </section>

  <main class="container final-main">
    <section class="final-section" aria-labelledby="matches-title">
      <h2 id="matches-title">Los partidos de cada finalista</h2>
      <p class="final-section-note">
        Dos partidos oficiales por club, de cualquier competición, desde el {windowStartLabel}. Un partido por jugar
        o con fecha pendiente no otorga puntos. Horas en la zona del estadio.
      </p>
      <div class="final-columns">
        {finalists.map((club) => (
          <div class="final-column" style={`--club-accent:${club.accent}`}>
            <h3 class="final-column-title">
              <span class={`club-flag-icon ${club.flag}`} aria-hidden="true"></span>{club.name}
            </h3>
            <ol class="slot-list">
              {club.plan.fixtures.map((fixture: any, index: number) => {
                const status = fixtureStatus(fixture);
                const rival = fixture.isHome ? fixture.awayClub : fixture.homeClub;
                const score = fixture.status === 'played' ? slotScore(club, fixture) : null;
                const cardsUnknown = fixture.status === 'played' && (fixture.yellowCards == null || fixture.redCards == null);
                return (
                  <li class={`slot ${status.cls}`}>
                    <div class="slot-when">
                      <span class="slot-number">Partido {index + 1}</span>
                      <span class="slot-date">{dateLabel(fixture)}</span>
                      <span class="slot-time">{timeLabel(fixture)}</span>
                    </div>
                    <div class="slot-what">
                      <p class="slot-rival">
                        <span class="slot-venue-tag">{fixture.isHome ? 'Local' : 'Visita'}</span>
                        {rival}
                      </p>
                      <p class="slot-comp">{fixture.sourceCompetition}{fixture.venue ? ` · ${fixture.venue}` : ''}</p>
                      {fixture.status === 'played' ? (
                        <p class="slot-result">
                          <strong>{fixture.goalsFor}–{fixture.goalsAgainst}</strong>
                          <span>TA {fixture.yellowCards ?? '?'}</span>
                          <span>TR {fixture.redCards ?? '?'}</span>
                          <span>FX {cardsUnknown ? '≤ ' : ''}{score?.total}{cardsUnknown ? '*' : ''}</span>
                        </p>
                      ) : null}
                    </div>
                    <div class="slot-state">
                      <span class="slot-chip">{status.label}</span>
                      <a class="slot-link" href={fixture.sourceUrl} target="_blank" rel="noreferrer"
                        aria-label={`${fixture.status === 'played' ? 'Ver partido' : 'Ver fuente'} de ${club.name}, partido ${index + 1}`}>
                        {fixture.status === 'played' ? 'Ver partido' : 'Ver fuente'}
                      </a>
                    </div>
                  </li>
                );
              })}
            </ol>
            {club.plan.pendingCompetition && (
              <p class="slot-warning">
                <strong>Puede cambiar:</strong> {club.plan.pendingCompetition.sourceCompetition} sin fecha publicada
                podría intercalarse antes del segundo partido. {club.plan.pendingCompetition.note}
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="final-section sim" aria-labelledby="sim-title" data-simulator>
      <h2 id="sim-title">Simulador de la final</h2>
      <p class="final-section-note">
        Marca qué pasa en cada partido que falta y mira cómo cambia el total. Es una simulación: no se guarda
        ni modifica el resultado oficial. Los partidos ya jugados cuentan con su puntaje real.
      </p>

      <div class="sim-verdict" data-sim-verdict aria-live="polite">
        <p class="sim-verdict-title" data-sim-verdict-title>Marca los partidos para simular</p>
        <p class="sim-verdict-sub" data-sim-verdict-sub></p>
      </div>

      <div class="final-columns">
        {finalists.map((club) => (
          <div class="final-column sim-column" style={`--club-accent:${club.accent}`} data-sim-club={club.clubId}>
            <h3 class="final-column-title">
              <span class={`club-flag-icon ${club.flag}`} aria-hidden="true"></span>{club.name}
              <span class="sim-total" data-sim-total>—</span>
            </h3>
            <p class="sim-base">
              Real hasta ahora: <strong>{club.total.total == null ? '0' : `${club.total.disciplinePending ? '≤ ' : ''}${club.total.total}`}</strong>
              {' '}({club.total.played} de 2 partidos jugados)
            </p>
            {simulableSlots(club).map(({ fixture, index }: any) => {
              const rival = fixture.isHome ? fixture.awayClub : fixture.homeClub;
              const name = `sim-${club.clubId}-${index}`;
              return (
                <fieldset class="sim-slot" data-sim-slot>
                  <legend>Partido {index + 1} · {rival}</legend>
                  <div class="sim-seg" role="radiogroup" aria-label={`Resultado de ${club.name} en el partido ${index + 1}`}>
                    <label><input type="radio" name={`${name}-r`} value="none" checked data-sim-result /><span>Sin simular</span></label>
                    <label><input type="radio" name={`${name}-r`} value="win" data-sim-result /><span>Gana</span></label>
                    <label><input type="radio" name={`${name}-r`} value="draw" data-sim-result /><span>Empata</span></label>
                    <label><input type="radio" name={`${name}-r`} value="loss" data-sim-result /><span>Pierde</span></label>
                  </div>
                  <div class="sim-options">
                    <label class="sim-field" data-sim-win-only>
                      <span>Diferencia de goles</span>
                      <select data-sim-margin disabled>
                        {marginOptions.map((m) => <option value={m}>{m === 1 ? '1 gol (sin bono)' : `${m} goles (+${m - 1})`}</option>)}
                      </select>
                    </label>
                    <label class="sim-check" data-sim-clean-wrap>
                      <input type="checkbox" data-sim-clean disabled /><span>Arco en cero (+1)</span>
                    </label>
                    <label class="sim-check" data-sim-heavy-wrap>
                      <input type="checkbox" data-sim-heavy disabled /><span>Derrota por 3 o más (−1)</span>
                    </label>
                    <label class="sim-field">
                      <span>Amarillas (−0,25 c/u)</span>
                      <input type="number" inputmode="numeric" min="0" max="12" step="1" value="0" data-sim-yellow />
                    </label>
                    <label class="sim-field">
                      <span>Rojas (−1 c/u)</span>
                      <input type="number" inputmode="numeric" min="0" max="5" step="1" value="0" data-sim-red />
                    </label>
                  </div>
                  <p class="sim-slot-points" data-sim-points>Sin simular</p>
                </fieldset>
              );
            })}
          </div>
        ))}
      </div>
      <button type="button" class="sim-reset" data-sim-reset>Reiniciar simulación</button>
      <script type="application/json" id="sim-data" set:html={JSON.stringify(simulatorClubs)} />
    </section>

    <section class="final-section" aria-labelledby="rules-title">
      <h2 id="rules-title">Cómo se decide</h2>
      <div class="rules-grid">
        <div class="rule-card">
          <h3>Puntaje de cada partido</h3>
          <ul>
            <li>Victoria 3 puntos, empate 1, derrota 0.</li>
            <li>+1 por cada gol de diferencia sobre el primero en una victoria.</li>
            <li>+1 si el arco queda en cero.</li>
            <li>−1 por derrota de 3 o más goles.</li>
            <li>−0,25 por amarilla y −1 por roja de jugadores.</li>
          </ul>
        </div>
        <div class="rule-card">
          <h3>Quién gana</h3>
          <ul>
            <li>Ambos finalistas deben completar sus dos partidos.</li>
            <li>Gana quien tenga el mayor total <strong>verificado</strong>, o cuyo total supere el máximo posible del rival.</li>
            <li>Con totales iguales la final queda en revisión: los desempates no están definidos.</li>
          </ul>
        </div>
        <div class="rule-card">
          <h3>Datos que faltan</h3>
          <ul>
            <li>Una tarjeta sin dos fuentes concordantes se muestra como «?» y nunca como cero.</li>
            <li>Con tarjetas pendientes el puntaje es un máximo provisional, marcado con «≤» y «*».</li>
            <li>Una fecha pendiente no se inventa: se publica cuando una fuente la confirma.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="final-section" aria-labelledby="path-title">
      <h2 id="path-title">Cómo llegaron</h2>
      <p class="final-section-note">Resultado de las semifinales, con el total fantasy de los dos partidos de cada club.</p>
      <div class="path-grid">
        {finalists.map((club) => (
          <article class="path-card" style={`--club-accent:${club.accent}`}>
            <h3>{club.name}</h3>
            <p class="path-line">
              <strong>{club.semifinalTotal.total}</strong>
              <span>puntos fantasy en semifinales</span>
            </p>
            <p class="path-sub">
              Superó a {club.semifinalRival.name}
              {club.semifinalRival.total.disciplinePending ? ` (máximo ${club.semifinalRival.total.total})` : ` (${club.semifinalRival.total.total})`}
              en {club.semifinalTotal.played} partidos oficiales.
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="final-section final-sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Fuentes y notas</h2>
      <p class="final-section-note">{fDoc.note} Corte de datos: {fDoc.verifiedAt}.</p>
      <details>
        <summary>Fuentes de cada partido</summary>
        <ul class="sources-list">
          {finalists.map((club) => (
            <li>
              <strong>{club.name}.</strong> {club.plan.note}
              <ul>
                {club.plan.fixtures.map((fixture: any, index: number) => (
                  <li>
                    <span>Partido {index + 1}: {fixture.note}</span>{' '}
                    {fixture.verificationSources.map((source: string, sourceIndex: number) => (
                      <a href={source} target="_blank" rel="noreferrer" class="source-link">Fuente {sourceIndex + 1}</a>
                    ))}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </details>
    </section>
  </main>
</Layout>

<script>
  import { computeFantasyScore } from '../../lib/tournaments/conference-league-sudamericana/index';

  const root = document.querySelector<HTMLElement>('[data-simulator]');
  const data: Array<{ clubId: string; name: string; baseTotal: number; basePlayed: number; disciplinePending: boolean }> =
    JSON.parse(document.getElementById('sim-data')?.textContent || '[]');
  const fmt = (value: number) => String(value).replace('.', ',');

  // Same scoring function as the official table, fed with goals implied by the marked options.
  function slotScore(clubId: string, slot: HTMLElement) {
    const result = slot.querySelector<HTMLInputElement>('[data-sim-result]:checked')?.value || 'none';
    const margin = slot.querySelector<HTMLSelectElement>('[data-sim-margin]')!;
    const clean = slot.querySelector<HTMLInputElement>('[data-sim-clean]')!;
    const heavy = slot.querySelector<HTMLInputElement>('[data-sim-heavy]')!;
    const yellow = slot.querySelector<HTMLInputElement>('[data-sim-yellow]')!;
    const red = slot.querySelector<HTMLInputElement>('[data-sim-red]')!;
    margin.disabled = result !== 'win';
    clean.disabled = result !== 'win' && result !== 'draw';
    heavy.disabled = result !== 'loss';
    if (clean.disabled) clean.checked = false;
    if (heavy.disabled) heavy.checked = false;
    const points = slot.querySelector<HTMLElement>('[data-sim-points]')!;
    if (result === 'none') { points.textContent = 'Sin simular'; return null; }

    let goalsFor = 0;
    let goalsAgainst = 0;
    if (result === 'win') {
      const diff = Number(margin.value);
      goalsAgainst = clean.checked ? 0 : 1;
      goalsFor = diff + goalsAgainst;
    } else if (result === 'draw') {
      goalsFor = goalsAgainst = clean.checked ? 0 : 1;
    } else {
      goalsFor = 0;
      goalsAgainst = heavy.checked ? 3 : 1;
    }
    const clampCount = (input: HTMLInputElement, max: number) => Math.min(max, Math.max(0, Math.floor(Number(input.value) || 0)));
    const score = computeFantasyScore({
      id: 'sim', clubId, roundId: 'KO-F', windowStart: '', windowEnd: '', sourceDate: '',
      goalsFor, goalsAgainst, yellowCards: clampCount(yellow, 12), redCards: clampCount(red, 5), counted: true,
    } as any);
    points.textContent = `${score.total >= 0 ? '+' : ''}${fmt(score.total)} pts · base ${fmt(score.basePoints)}, bono ${fmt(score.bonusPoints)}, descuento ${fmt(score.penaltyPoints)}`;
    return score.total;
  }

  function update() {
    if (!root) return;
    const totals = data.map((club) => {
      const column = root.querySelector<HTMLElement>(`[data-sim-club="${club.clubId}"]`)!;
      const slots = [...column.querySelectorAll<HTMLElement>('[data-sim-slot]')];
      const scores = slots.map((slot) => slotScore(club.clubId, slot));
      const simulated = scores.filter((score): score is number => score != null);
      const total = club.baseTotal + simulated.reduce((sum, value) => sum + value, 0);
      const complete = club.basePlayed + simulated.length >= 2;
      const label = `${club.disciplinePending ? '≤ ' : ''}${fmt(total)}`;
      column.querySelector<HTMLElement>('[data-sim-total]')!.textContent = complete ? label : `${label} (parcial)`;
      return { club, total, complete, any: simulated.length > 0 };
    });

    const title = root.querySelector<HTMLElement>('[data-sim-verdict-title]')!;
    const sub = root.querySelector<HTMLElement>('[data-sim-verdict-sub]')!;
    const [a, b] = totals;
    if (!totals.some((entry) => entry.any)) {
      title.textContent = 'Marca los partidos para simular';
      sub.textContent = '';
    } else if (!a.complete || !b.complete) {
      const missing = totals.filter((entry) => !entry.complete).map((entry) => entry.club.name).join(' y ');
      title.textContent = a.total === b.total ? 'Van empatados por ahora' : `Va arriba ${a.total > b.total ? a.club.name : b.club.name}`;
      sub.textContent = `Falta simular partidos de ${missing} para definir un campeón.`;
    } else if (a.total === b.total) {
      title.textContent = `Empate en ${fmt(a.total)} puntos`;
      sub.textContent = 'Los desempates no están definidos: en la realidad la final quedaría en revisión.';
    } else {
      const winner = a.total > b.total ? a : b;
      const loser = winner === a ? b : a;
      title.textContent = `Campeón simulado: ${winner.club.name}`;
      sub.textContent = `${fmt(winner.total)} contra ${fmt(loser.total)} (${fmt(Math.abs(a.total - b.total))} de diferencia).`;
    }
  }

  root?.addEventListener('input', update);
  root?.addEventListener('change', update);
  root?.querySelector('[data-sim-reset]')?.addEventListener('click', () => {
    root.querySelectorAll<HTMLInputElement>('[data-sim-result][value="none"]').forEach((input) => { input.checked = true; });
    root.querySelectorAll<HTMLInputElement>('[data-sim-yellow], [data-sim-red]').forEach((input) => { input.value = '0'; });
    root.querySelectorAll<HTMLSelectElement>('[data-sim-margin]').forEach((select) => { select.value = '1'; });
    root.querySelectorAll<HTMLInputElement>('[data-sim-clean], [data-sim-heavy]').forEach((input) => { input.checked = false; });
    update();
  });
  update();
</script>

<style>
  /* Hallmark · macrostructure: Scoreboard Split (custom) · tone: austere, athletic
   * theme: night-match (tokens.css) · all colour and type via named tokens */
  .final-hero {
    background: var(--color-ink);
    color: var(--color-paper);
    border-bottom: 2px solid var(--color-conference);
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .final-hero-inner { display: grid; gap: var(--space-lg); min-width: 0; }
  .final-back {
    justify-self: start;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--color-silver);
    padding-block: var(--space-xs);
  }
